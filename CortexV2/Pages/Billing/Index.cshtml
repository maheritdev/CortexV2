@page
@model Cortex.Pages.Billing.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_DashboardLayout.cshtml";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Billing[0].BillDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Billing[0].DueDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Billing[0].TotalAmount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Billing[0].PaidAmount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Billing[0].Balance)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Billing[0].isPaid)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Billing[0].Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Billing[0].InsuranceClaimAmount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Billing[0].Notes)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Billing[0].PaidDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Billing[0].CreatedByNavigation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Billing[0].Patient)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Billing)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.BillDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DueDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TotalAmount)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PaidAmount)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Balance)
                </td>
                <td>
                    @if (item.isPaid == true)
                    {
                        <i class="fa-solid fa-money-bill text-success"></i>
                    }
                    else
                    {
                        if (item.Status == "Partial")
                        {
                            <i class="fa-solid fa-money-bill text-warning"></i>
                        }
                        else
                        {
                            <i class="fa-solid fa-money-bill text-danger"></i>
                        }
                    }
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Status)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.InsuranceClaimAmount)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Notes)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PaidDate)
                </td>
                <td>
                    @Html.Label($"{item.CreatedByNavigation.FirstName}  {item.CreatedByNavigation.LastName}")
                </td>
                <td>
                    @Html.Label($"{item.Patient.FirstName}  {item.Patient.LastName}")
                </td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.BillId">Edit</a> |
                    <a asp-page="./Details" asp-route-id="@item.BillId">Details</a> |
                    <a asp-page="./Delete" asp-route-id="@item.BillId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
