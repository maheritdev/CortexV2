@page
@model Cortex.Pages.Department.EditModel

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Pages/Shared/_DashboardLayout.cshtml";
}

<h1>Edit</h1>

<h4>Department</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Department.DepartmentId" />
            <div class="form-group">
                <label asp-for="Department.DepartmentName" class="control-label"></label>
                <input asp-for="Department.DepartmentName" class="form-control" />
                <span asp-validation-for="Department.DepartmentName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Department.Description" class="control-label"></label>
                <input asp-for="Department.Description" class="form-control" />
                <span asp-validation-for="Department.Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Department.Location" class="control-label"></label>
                <input asp-for="Department.Location" class="form-control" />
                <span asp-validation-for="Department.Location" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Department.ContactNumber" class="control-label"></label>
                <input asp-for="Department.ContactNumber" class="form-control" />
                <span asp-validation-for="Department.ContactNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Department.HeadOfDepartment" class="control-label"></label>
                <select asp-for="Department.HeadOfDepartment" class="form-control" asp-items="ViewBag.HeadOfDepartment"></select>
                <span asp-validation-for="Department.HeadOfDepartment" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>
