@page
@model Cortex.Pages.Department.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_DashboardLayout.cshtml";
}

<h1>Index</h1>

<p>
    <a asp-page="Create" class="px-3 py-2 btn-outline-primary  rounded"> <i class="fa-solid fa-user-plus"></i> Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Department[0].DepartmentName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Department[0].Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Department[0].Location)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Department[0].ContactNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Department[0].HeadOfDepartmentNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Department) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.DepartmentName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Location)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ContactNumber)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.HeadOfDepartmentNavigation.StaffID)
            </td>
            <td>
                <a class="btn btn-sm btn-outline-secondary me-2" asp-page="./Edit" asp-route-id="@item.DepartmentId"> <i class="fas fa-edit"></i> Edit</a>
                <a class="btn btn-sm btn-outline-primary me-2" asp-page="./Details" asp-route-id="@item.DepartmentId"> <i class="fas fa-eye"></i> Details</a>
                <a class="btn btn-sm btn-outline-danger" asp-page="./Delete" asp-route-id="@item.DepartmentId"><i class="fas fa-trash"></i> Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
