@page
@model Cortex.Pages.Room.CreateModel

@{
    ViewData["Title"] = "Add New Room";
    Layout = "~/Pages/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid py-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-page="./Index">Rooms</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Add New Room</li>
                </ol>
            </nav>
            <h1 class="h3 mb-0">Add New Room</h1>
            <p class="text-muted mb-0">Create a new room in the hospital system</p>
        </div>
        <div>
            <a asp-page="./Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Back to List
            </a>
        </div>
    </div>

    <!-- Main Form Card -->
    <div class="card shadow-sm">
        <div class="card-header bg-light py-3">
            <div class="d-flex align-items-center">
                <div class="icon-shape icon-md bg-primary bg-gradient text-white rounded-circle d-flex align-items-center justify-content-center me-3">
                    <i class="fas fa-plus fa-lg"></i>
                </div>
                <div>
                    <h2 class="h4 mb-0">New Room Details</h2>
                    <p class="text-muted mb-0">Fill in all required fields marked with *</p>
                </div>
            </div>
        </div>

        <form method="post" class="needs-validation" novalidate>
            <div class="card-body">
                <!-- Validation Summary -->
                <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none" role="alert" id="validationSummary">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    Please correct the errors below.
                </div>

                <div class="row">
                    <!-- Basic Information Column -->
                    <div class="col-lg-6">
                        <div class="card border mb-4">
                            <div class="card-header bg-light">
                                <h5 class="mb-0">Basic Information</h5>
                            </div>
                            <div class="card-body">
                                <!-- Room Number -->
                                <div class="mb-3">
                                    <label asp-for="Room.RoomNumber" class="form-label fw-medium">
                                        <i class="fas fa-hashtag text-primary me-2"></i>Room Number *
                                    </label>
                                    <input asp-for="Room.RoomNumber" class="form-control form-control-lg"
                                           placeholder="e.g., 101, 202, ICU-1" required />
                                    <div class="invalid-feedback">
                                        Please provide a room number.
                                    </div>
                                    <div class="form-text">Unique identifier for the room</div>
                                    <span asp-validation-for="Room.RoomNumber" class="text-danger small"></span>
                                </div>

                                <!-- Room Type -->
                                <div class="mb-3">
                                    <label asp-for="Room.RoomType" class="form-label fw-medium">
                                        <i class="fas fa-door-open text-info me-2"></i>Room Type *
                                    </label>
                                    <select asp-for="Room.RoomType" class="form-select" required>
                                        <option value="">Select Room Type</option>
                                        <option value="Private">Private Room</option>
                                        <option value="Semi-Private">Semi-Private Room</option>
                                        <option value="Ward">Ward</option>
                                        <option value="ICU">Intensive Care Unit (ICU)</option>
                                        <option value="Emergency">Emergency Room</option>
                                        <option value="Operation">Operating Room</option>
                                        <option value="Delivery">Delivery Room</option>
                                        <option value="Isolation">Isolation Room</option>
                                        <option value="Examination">Examination Room</option>
                                        <option value="Consultation">Consultation Room</option>
                                        <option value="Other">Other</option>
                                    </select>
                                    <div class="invalid-feedback">
                                        Please select a room type.
                                    </div>
                                    <span asp-validation-for="Room.RoomType" class="text-danger small"></span>
                                </div>

                                <!-- Capacity -->
                                <div class="mb-3">
                                    <label asp-for="Room.Capacity" class="form-label fw-medium">
                                        <i class="fas fa-users text-success me-2"></i>Capacity *
                                    </label>
                                    <div class="input-group">
                                        <input asp-for="Room.Capacity" class="form-control"
                                               type="number" min="1" value="1" placeholder="Number of beds" required />
                                        <span class="input-group-text">beds</span>
                                    </div>
                                    <div class="invalid-feedback">
                                        Please provide room capacity.
                                    </div>
                                    <div class="form-text">Maximum number of patients the room can accommodate</div>
                                    <span asp-validation-for="Room.Capacity" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Department & Pricing Column -->
                    <div class="col-lg-6">
                        <div class="card border mb-4">
                            <div class="card-header bg-light">
                                <h5 class="mb-0">Department & Pricing</h5>
                            </div>
                            <div class="card-body">
                                <!-- Department -->
                                <div class="mb-3">
                                    <label asp-for="Room.DepartmentId" class="form-label fw-medium">
                                        <i class="fas fa-building text-warning me-2"></i>Department
                                    </label>
                                    <select asp-for="Room.DepartmentId" class="form-control department-select"
                                            data-live-search="true" title="Choose department...">
                                        <option value="">No Department (General)</option>
                                        @if (ViewData["DepartmentId"] is SelectList departments && departments != null)
                                        {
                                            @foreach (var item in departments)
                                            {
                                                <option value="@item.Value">@item.Text</option>
                                            }
                                        }
                                    </select>
                                    <div class="form-text">Assign to a specific department (optional)</div>
                                    <span asp-validation-for="Room.DepartmentId" class="text-danger small"></span>
                                </div>

                                <!-- Rate Per Day -->
                                <div class="mb-3">
                                    <label asp-for="Room.RatePerDay" class="form-label fw-medium">
                                        <i class="fas fa-dollar-sign text-success me-2"></i>Rate Per Day *
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text">$</span>
                                        <input asp-for="Room.RatePerDay" class="form-control"
                                               type="number" step="0.01" min="0" placeholder="0.00" required />
                                        <span class="input-group-text">per day</span>
                                    </div>
                                    <div class="invalid-feedback">
                                        Please provide a daily rate.
                                    </div>
                                    <span asp-validation-for="Room.RatePerDay" class="text-danger small"></span>
                                </div>

                                <!-- Initial Status -->
                                <div class="mb-3">
                                    <label class="form-label fw-medium">
                                        <i class="fas fa-circle text-info me-2"></i>Initial Status
                                    </label>
                                    <select class="form-select" id="initialStatus">
                                        <option value="Available" selected>Available</option>
                                        <option value="Maintenance">Under Maintenance</option>
                                        <option value="Cleaning">Cleaning</option>
                                        <option value="Reserved">Reserved</option>
                                    </select>
                                    <div class="form-text">Room status upon creation</div>
                                </div>

                                <!-- Room Features (Optional) -->
                                <div class="mb-3">
                                    <label class="form-label fw-medium">
                                        <i class="fas fa-check-circle text-primary me-2"></i>Room Features (Optional)
                                    </label>
                                    <div class="row">
                                        <div class="col-6">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="privateBathroom">
                                                <label class="form-check-label small" for="privateBathroom">
                                                    Private Bathroom
                                                </label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="tv">
                                                <label class="form-check-label small" for="tv">
                                                    TV
                                                </label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="wifi">
                                                <label class="form-check-label small" for="wifi">
                                                    WiFi
                                                </label>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="ac">
                                                <label class="form-check-label small" for="ac">
                                                    Air Conditioning
                                                </label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="emergencyCall">
                                                <label class="form-check-label small" for="emergencyCall">
                                                    Emergency Call
                                                </label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="oxygen">
                                                <label class="form-check-label small" for="oxygen">
                                                    Oxygen Supply
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Room Description & Notes -->
                    <div class="col-12">
                        <div class="card border">
                            <div class="card-header bg-light">
                                <h5 class="mb-0">Additional Information</h5>
                            </div>
                            <div class="card-body">
                                <!-- Room Description -->
                                <div class="mb-3">
                                    <label for="roomDescription" class="form-label fw-medium">
                                        <i class="fas fa-align-left text-secondary me-2"></i>Room Description (Optional)
                                    </label>
                                    <textarea class="form-control" id="roomDescription" rows="3"
                                              placeholder="Additional details about the room, special equipment, or notes..."></textarea>
                                </div>

                                <!-- Floor & Wing Information -->
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label for="floorNumber" class="form-label fw-medium">
                                            <i class="fas fa-layer-group text-info me-2"></i>Floor Number
                                        </label>
                                        <select class="form-select" id="floorNumber">
                                            <option value="">Select Floor</option>
                                            <option value="G">Ground Floor</option>
                                            <option value="1">1st Floor</option>
                                            <option value="2">2nd Floor</option>
                                            <option value="3">3rd Floor</option>
                                            <option value="4">4th Floor</option>
                                            <option value="5">5th Floor</option>
                                            <option value="6">6th Floor</option>
                                            <option value="7">7th Floor</option>
                                            <option value="8">8th Floor</option>
                                            <option value="9">9th Floor</option>
                                            <option value="10">10th Floor</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label for="wing" class="form-label fw-medium">
                                            <i class="fas fa-compass text-warning me-2"></i>Wing/Section
                                        </label>
                                        <select class="form-select" id="wing">
                                            <option value="">Select Wing</option>
                                            <option value="North">North Wing</option>
                                            <option value="South">South Wing</option>
                                            <option value="East">East Wing</option>
                                            <option value="West">West Wing</option>
                                            <option value="Central">Central Wing</option>
                                            <option value="Emergency">Emergency Wing</option>
                                            <option value="Surgical">Surgical Wing</option>
                                            <option value="Maternity">Maternity Wing</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Pricing Suggestions -->
                <div class="alert alert-info mt-4">
                    <div class="d-flex">
                        <div class="flex-shrink-0">
                            <i class="fas fa-lightbulb fa-2x text-info"></i>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h5 class="alert-heading">Suggested Pricing Guidelines</h5>
                            <div class="row">
                                <div class="col-md-4">
                                    <small class="text-muted d-block">Private Room</small>
                                    <strong>$150 - $300/day</strong>
                                </div>
                                <div class="col-md-4">
                                    <small class="text-muted d-block">Semi-Private</small>
                                    <strong>$80 - $150/day</strong>
                                </div>
                                <div class="col-md-4">
                                    <small class="text-muted d-block">Ward</small>
                                    <strong>$40 - $80/day</strong>
                                </div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-md-4">
                                    <small class="text-muted d-block">ICU</small>
                                    <strong>$500 - $1000/day</strong>
                                </div>
                                <div class="col-md-4">
                                    <small class="text-muted d-block">Emergency</small>
                                    <strong>$200 - $400/day</strong>
                                </div>
                                <div class="col-md-4">
                                    <small class="text-muted d-block">Operating Room</small>
                                    <strong>$800 - $1500/day</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Card Footer with Action Buttons -->
            <div class="card-footer bg-light d-flex justify-content-between py-3">
                <div>
                    <a asp-page="./Index" class="btn btn-outline-secondary">
                        <i class="fas fa-times me-2"></i>Cancel
                    </a>
                </div>
                <div>
                    <button type="submit" class="btn btn-primary px-5">
                        <i class="fas fa-plus-circle me-2"></i>Create Room
                    </button>
                    <button type="button" class="btn btn-outline-primary" onclick="clearForm()">
                        <i class="fas fa-redo me-2"></i>Clear Form
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- Quick Template Buttons -->
    <div class="mt-4">
        <div class="card border">
            <div class="card-header bg-light">
                <h6 class="mb-0"><i class="fas fa-copy me-2"></i>Quick Room Templates</h6>
            </div>
            <div class="card-body">
                <p class="text-muted small mb-3">Use pre-filled templates for common room types:</p>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-sm btn-outline-info" onclick="useTemplate('private')">
                        <i class="fas fa-bed me-1"></i>Private Room
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-info" onclick="useTemplate('semi')">
                        <i class="fas fa-bed me-1"></i>Semi-Private
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-info" onclick="useTemplate('ward')">
                        <i class="fas fa-procedures me-1"></i>Ward
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-info" onclick="useTemplate('icu')">
                        <i class="fas fa-heartbeat me-1"></i>ICU
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-info" onclick="useTemplate('emergency')">
                        <i class="fas fa-ambulance me-1"></i>Emergency
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-info" onclick="useTemplate('operation')">
                        <i class="fas fa-syringe me-1"></i>Operating Room
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Form validation
        (function () {
            'use strict'
            var forms = document.querySelectorAll('.needs-validation')
            Array.prototype.slice.call(forms)
                .forEach(function (form) {
                    form.addEventListener('submit', function (event) {
                        if (!form.checkValidity()) {
                            event.preventDefault()
                            event.stopPropagation()

                            // Show validation summary
                            document.getElementById('validationSummary').classList.remove('d-none');
                        }
                        form.classList.add('was-validated')
                    }, false)
                })
        })()

        // Auto-suggest room number based on floor and wing
        document.getElementById('floorNumber').addEventListener('change', function() {
            const floor = this.value;
            const wing = document.getElementById('wing').value;
            const roomNumberInput = document.getElementById('Room_RoomNumber');

            if (floor && !roomNumberInput.value) {
                let suggestedNumber = floor;
                if (wing) {
                    suggestedNumber += wing.charAt(0);
                }
                suggestedNumber += '01';
                roomNumberInput.value = suggestedNumber;
            }
        });

        document.getElementById('wing').addEventListener('change', function() {
            const floor = document.getElementById('floorNumber').value;
            const wing = this.value;
            const roomNumberInput = document.getElementById('Room_RoomNumber');

            if (floor && wing && !roomNumberInput.value) {
                const suggestedNumber = floor + wing.charAt(0) + '01';
                roomNumberInput.value = suggestedNumber;
            }
        });

        // Auto-suggest capacity based on room type
        document.getElementById('Room_RoomType').addEventListener('change', function() {
            const roomType = this.value;
            const capacityInput = document.getElementById('Room_Capacity');
            const rateInput = document.getElementById('Room_RatePerDay');

            if (roomType && !capacityInput.value) {
                let capacity = 1;
                let suggestedRate = 100.00;

                switch(roomType) {
                    case 'Private':
                        capacity = 1;
                        suggestedRate = 200.00;
                        break;
                    case 'Semi-Private':
                        capacity = 2;
                        suggestedRate = 120.00;
                        break;
                    case 'Ward':
                        capacity = 4;
                        suggestedRate = 60.00;
                        break;
                    case 'ICU':
                        capacity = 1;
                        suggestedRate = 750.00;
                        break;
                    case 'Emergency':
                        capacity = 1;
                        suggestedRate = 300.00;
                        break;
                    case 'Operation':
                        capacity = 0;
                        suggestedRate = 1000.00;
                        break;
                    case 'Delivery':
                        capacity = 1;
                        suggestedRate = 400.00;
                        break;
                    case 'Isolation':
                        capacity = 1;
                        suggestedRate = 250.00;
                        break;
                    default:
                        capacity = 1;
                        suggestedRate = 150.00;
                }

                capacityInput.value = capacity;
                if (!rateInput.value) {
                    rateInput.value = suggestedRate.toFixed(2);
                }
            }
        });

        // Clear form function
        function clearForm() {
            if (confirm('Are you sure you want to clear all form fields?')) {
                document.querySelector('form').reset();
                document.querySelector('form').classList.remove('was-validated');
                document.getElementById('validationSummary').classList.add('d-none');

                // Clear additional fields
                document.getElementById('roomDescription').value = '';
                document.getElementById('floorNumber').value = '';
                document.getElementById('wing').value = '';
                document.getElementById('initialStatus').value = 'Available';

                // Clear checkboxes
                document.querySelectorAll('input[type="checkbox"]').forEach(cb => {
                    cb.checked = false;
                });
            }
        }

        // Template functions
        function useTemplate(type) {
            if (confirm('Apply template? This will overwrite current form values.')) {
                const form = document.querySelector('form');
                form.classList.remove('was-validated');

                switch(type) {
                    case 'private':
                        document.getElementById('Room_RoomNumber').value = '101';
                        document.getElementById('Room_RoomType').value = 'Private';
                        document.getElementById('Room_Capacity').value = '1';
                        document.getElementById('Room_RatePerDay').value = '250.00';
                        document.getElementById('floorNumber').value = '1';
                        document.getElementById('wing').value = 'North';
                        break;
                    case 'semi':
                        document.getElementById('Room_RoomNumber').value = '202';
                        document.getElementById('Room_RoomType').value = 'Semi-Private';
                        document.getElementById('Room_Capacity').value = '2';
                        document.getElementById('Room_RatePerDay').value = '150.00';
                        document.getElementById('floorNumber').value = '2';
                        document.getElementById('wing').value = 'South';
                        break;
                    case 'ward':
                        document.getElementById('Room_RoomNumber').value = 'W301';
                        document.getElementById('Room_RoomType').value = 'Ward';
                        document.getElementById('Room_Capacity').value = '4';
                        document.getElementById('Room_RatePerDay').value = '75.00';
                        document.getElementById('floorNumber').value = '3';
                        document.getElementById('wing').value = 'West';
                        break;
                    case 'icu':
                        document.getElementById('Room_RoomNumber').value = 'ICU-01';
                        document.getElementById('Room_RoomType').value = 'ICU';
                        document.getElementById('Room_Capacity').value = '1';
                        document.getElementById('Room_RatePerDay').value = '850.00';
                        document.getElementById('floorNumber').value = '1';
                        document.getElementById('wing').value = 'Central';
                        break;
                    case 'emergency':
                        document.getElementById('Room_RoomNumber').value = 'ER-01';
                        document.getElementById('Room_RoomType').value = 'Emergency';
                        document.getElementById('Room_Capacity').value = '1';
                        document.getElementById('Room_RatePerDay').value = '350.00';
                        document.getElementById('floorNumber').value = 'G';
                        document.getElementById('wing').value = 'Emergency';
                        break;
                    case 'operation':
                        document.getElementById('Room_RoomNumber').value = 'OR-01';
                        document.getElementById('Room_RoomType').value = 'Operation';
                        document.getElementById('Room_Capacity').value = '0';
                        document.getElementById('Room_RatePerDay').value = '1200.00';
                        document.getElementById('floorNumber').value = '2';
                        document.getElementById('wing').value = 'Surgical';
                        break;
                }

                // Check appropriate features
                if (type === 'icu' || type === 'emergency' || type === 'operation') {
                    document.getElementById('oxygen').checked = true;
                    document.getElementById('emergencyCall').checked = true;
                }
                if (type === 'private' || type === 'semi') {
                    document.getElementById('privateBathroom').checked = true;
                    document.getElementById('tv').checked = true;
                    document.getElementById('wifi').checked = true;
                    document.getElementById('ac').checked = true;
                }

                alert('Template applied. Please review and adjust values as needed.');
            }
        }

        // Initialize department select with search
        document.addEventListener('DOMContentLoaded', function() {
            const departmentSelect = document.querySelector('.department-select');
            if (departmentSelect) {
                // Simple search functionality
                departmentSelect.addEventListener('keyup', function(e) {
                    const searchTerm = e.target.value.toLowerCase();
                    const options = departmentSelect.querySelectorAll('option');

                    options.forEach(option => {
                        const text = option.textContent.toLowerCase();
                        if (text.includes(searchTerm) || option.value === '') {
                            option.style.display = '';
                        } else {
                            option.style.display = 'none';
                        }
                    });
                });
            }
        });
    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
