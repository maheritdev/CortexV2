@page
@model Cortex.Pages.Room.EditModel

@{
    ViewData["Title"] = "Edit Room";
    Layout = "~/Pages/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid py-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-page="./Index">Rooms</a></li>
                    <li class="breadcrumb-item"><a asp-page="./Details" asp-route-id="@Model.Room.RoomId">Room @Model.Room.RoomNumber</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Edit</li>
                </ol>
            </nav>
            <h1 class="h3 mb-0">Edit Room</h1>
            <p class="text-muted mb-0">Update details for Room @Model.Room.RoomNumber</p>
        </div>
        <div>
            <a asp-page="./Details" asp-route-id="@Model.Room.RoomId" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Cancel
            </a>
        </div>
    </div>

    <!-- Main Form Card -->
    <div class="card shadow-sm">
        <div class="card-header bg-light py-3">
            <div class="d-flex align-items-center">
                <div class="icon-shape icon-md bg-primary bg-gradient text-white rounded-circle d-flex align-items-center justify-content-center me-3">
                    <i class="fas fa-edit fa-lg"></i>
                </div>
                <div>
                    <h2 class="h4 mb-0">Edit Room @Model.Room.RoomNumber</h2>
                    <p class="text-muted mb-0">ID: @Model.Room.RoomId • Current Status: <span class="badge bg-@GetStatusBadgeClass(Model.Room.Status)">@Model.Room.Status</span></p>
                </div>
            </div>
        </div>

        <form method="post" class="needs-validation" novalidate>
            <div class="card-body">
                <input type="hidden" asp-for="Room.RoomId" />

                <!-- Validation Summary -->
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    Please correct the errors below.
                </div>

                <div class="row">
                    <!-- Basic Information Column -->
                    <div class="col-lg-6">
                        <div class="card border mb-4">
                            <div class="card-header bg-light">
                                <h5 class="mb-0">Basic Information</h5>
                            </div>
                            <div class="card-body">
                                <!-- Room Number -->
                                <div class="mb-3">
                                    <label asp-for="Room.RoomNumber" class="form-label fw-medium">
                                        <i class="fas fa-hashtag text-primary me-2"></i>Room Number *
                                    </label>
                                    <input asp-for="Room.RoomNumber" class="form-control form-control-lg"
                                           placeholder="e.g., 101, 202, ICU-1" required />
                                    <div class="invalid-feedback">
                                        Please provide a room number.
                                    </div>
                                    <div class="form-text">Unique identifier for the room</div>
                                    <span asp-validation-for="Room.RoomNumber" class="text-danger small"></span>
                                </div>

                                <!-- Room Type -->
                                <div class="mb-3">
                                    <label asp-for="Room.RoomType" class="form-label fw-medium">
                                        <i class="fas fa-door-open text-info me-2"></i>Room Type *
                                    </label>
                                    <select asp-for="Room.RoomType" class="form-select" required>
                                        <option value="">Select Room Type</option>
                                        <option value="Private">Private Room</option>
                                        <option value="Semi-Private">Semi-Private Room</option>
                                        <option value="Ward">Ward</option>
                                        <option value="ICU">Intensive Care Unit (ICU)</option>
                                        <option value="Emergency">Emergency Room</option>
                                        <option value="Operation">Operating Room</option>
                                        <option value="Delivery">Delivery Room</option>
                                        <option value="Isolation">Isolation Room</option>
                                        <option value="Examination">Examination Room</option>
                                        <option value="Consultation">Consultation Room</option>
                                        <option value="Other">Other</option>
                                    </select>
                                    <div class="invalid-feedback">
                                        Please select a room type.
                                    </div>
                                    <span asp-validation-for="Room.RoomType" class="text-danger small"></span>
                                </div>

                                <!-- Capacity -->
                                <div class="mb-3">
                                    <label asp-for="Room.Capacity" class="form-label fw-medium">
                                        <i class="fas fa-users text-success me-2"></i>Capacity *
                                    </label>
                                    <div class="input-group">
                                        <input asp-for="Room.Capacity" class="form-control"
                                               type="number" min="0" value="1" placeholder="Number of beds" required />
                                        <span class="input-group-text">beds</span>
                                    </div>
                                    <div class="invalid-feedback">
                                        Please provide room capacity.
                                    </div>
                                    <div class="form-text">Maximum number of patients the room can accommodate (0 for non-patient rooms)</div>
                                    <span asp-validation-for="Room.Capacity" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Status & Pricing Column -->
                    <div class="col-lg-6">
                        <div class="card border mb-4">
                            <div class="card-header bg-light">
                                <h5 class="mb-0">Status & Pricing</h5>
                            </div>
                            <div class="card-body">
                                <!-- Status -->
                                <div class="mb-3">
                                    <label asp-for="Room.Status" class="form-label fw-medium">
                                        <i class="fas fa-circle text-primary me-2"></i>Status *
                                    </label>
                                    <select asp-for="Room.Status" class="form-select" required>
                                        <option value="">Select Status</option>
                                        <option value="Available">Available</option>
                                        <option value="Occupied">Occupied</option>
                                        <option value="Maintenance">Under Maintenance</option>
                                        <option value="Cleaning">Cleaning</option>
                                        <option value="Reserved">Reserved</option>
                                        <option value="Out of Service">Out of Service</option>
                                    </select>
                                    <div class="invalid-feedback">
                                        Please select a status.
                                    </div>
                                    <span asp-validation-for="Room.Status" class="text-danger small"></span>
                                </div>

                                <!-- Rate Per Day -->
                                <div class="mb-3">
                                    <label asp-for="Room.RatePerDay" class="form-label fw-medium">
                                        <i class="fas fa-dollar-sign text-success me-2"></i>Rate Per Day *
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text">$</span>
                                        <input asp-for="Room.RatePerDay" class="form-control"
                                               type="number" step="0.01" min="0" placeholder="0.00" required />
                                        <span class="input-group-text">per day</span>
                                    </div>
                                    <div class="invalid-feedback">
                                        Please provide a daily rate.
                                    </div>
                                    <span asp-validation-for="Room.RatePerDay" class="text-danger small"></span>
                                </div>

                                <!-- Department -->
                                <div class="mb-3">
                                    <label asp-for="Room.DepartmentId" class="form-label fw-medium">
                                        <i class="fas fa-building text-warning me-2"></i>Department
                                    </label>
                                    <select asp-for="Room.DepartmentId" class="form-control department-select"
                                            data-live-search="true" title="Choose department...">
                                        <option value="">No Department (General)</option>
                                        @if (ViewData["DepartmentId"] is SelectList departments && departments != null)
                                        {
                                            @foreach (var item in departments)
                                            {
                                                <option value="@item.Value">@item.Text</option>
                                            }
                                        }
                                    </select>
                                    <div class="form-text">Assign to a specific department (optional)</div>
                                    <span asp-validation-for="Room.DepartmentId" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Quick Actions Section -->
                    <div class="col-12">
                        <div class="card border mb-4">
                            <div class="card-header bg-light">
                                <h5 class="mb-0">Quick Actions</h5>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-medium">
                                            <i class="fas fa-sync-alt text-info me-2"></i>Status Quick Changes
                                        </label>
                                        <div class="d-flex flex-wrap gap-2">
                                            <button type="button" class="btn btn-sm btn-outline-success" onclick="setStatus('Available')">
                                                <i class="fas fa-check-circle me-1"></i>Mark Available
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-warning" onclick="setStatus('Occupied')">
                                                <i class="fas fa-user me-1"></i>Mark Occupied
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="setStatus('Maintenance')">
                                                <i class="fas fa-tools me-1"></i>Mark Maintenance
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-info" onclick="setStatus('Cleaning')">
                                                <i class="fas fa-broom me-1"></i>Mark Cleaning
                                            </button>
                                        </div>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-medium">
                                            <i class="fas fa-percentage text-primary me-2"></i>Rate Adjustments
                                        </label>
                                        <div class="d-flex flex-wrap gap-2">
                                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="adjustRate(-10)">
                                                <i class="fas fa-minus me-1"></i>-10%
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="adjustRate(-5)">
                                                <i class="fas fa-minus me-1"></i>-5%
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="adjustRate(5)">
                                                <i class="fas fa-plus me-1"></i>+5%
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="adjustRate(10)">
                                                <i class="fas fa-plus me-1"></i>+10%
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <!-- Capacity Warning (if room is occupied but capacity changed) -->
                                @if (Model.Room.Status == "Occupied" && Model.Room.Capacity > 0)
                                {
                                    <div class="alert alert-warning mt-3">
                                        <div class="d-flex align-items-center">
                                            <i class="fas fa-exclamation-triangle me-3 fa-lg"></i>
                                            <div>
                                                <h6 class="alert-heading mb-1">Occupied Room Warning</h6>
                                                <p class="mb-0">This room is currently occupied. Changing capacity may affect current patient accommodations.</p>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Room Features & Notes -->
                    <div class="col-12">
                        <div class="card border">
                            <div class="card-header bg-light">
                                <h5 class="mb-0">Additional Information</h5>
                            </div>
                            <div class="card-body">
                                <!-- Room Features -->
                                <div class="mb-4">
                                    <label class="form-label fw-medium">
                                        <i class="fas fa-check-circle text-primary me-2"></i>Room Features
                                    </label>
                                    <div class="row">
                                        <div class="col-md-3 col-6 mb-2">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="privateBathroom">
                                                <label class="form-check-label" for="privateBathroom">
                                                    <i class="fas fa-bath me-1 text-info"></i>Private Bathroom
                                                </label>
                                            </div>
                                        </div>
                                        <div class="col-md-3 col-6 mb-2">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="tv">
                                                <label class="form-check-label" for="tv">
                                                    <i class="fas fa-tv me-1 text-info"></i>TV
                                                </label>
                                            </div>
                                        </div>
                                        <div class="col-md-3 col-6 mb-2">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="wifi">
                                                <label class="form-check-label" for="wifi">
                                                    <i class="fas fa-wifi me-1 text-info"></i>WiFi
                                                </label>
                                            </div>
                                        </div>
                                        <div class="col-md-3 col-6 mb-2">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="ac">
                                                <label class="form-check-label" for="ac">
                                                    <i class="fas fa-wind me-1 text-info"></i>Air Conditioning
                                                </label>
                                            </div>
                                        </div>
                                        <div class="col-md-3 col-6 mb-2">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="emergencyCall">
                                                <label class="form-check-label" for="emergencyCall">
                                                    <i class="fas fa-bell me-1 text-danger"></i>Emergency Call
                                                </label>
                                            </div>
                                        </div>
                                        <div class="col-md-3 col-6 mb-2">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="oxygen">
                                                <label class="form-check-label" for="oxygen">
                                                    <i class="fas fa-lungs me-1 text-success"></i>Oxygen Supply
                                                </label>
                                            </div>
                                        </div>
                                        <div class="col-md-3 col-6 mb-2">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="monitor">
                                                <label class="form-check-label" for="monitor">
                                                    <i class="fas fa-heartbeat me-1 text-danger"></i>Patient Monitor
                                                </label>
                                            </div>
                                        </div>
                                        <div class="col-md-3 col-6 mb-2">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="refrigerator">
                                                <label class="form-check-label" for="refrigerator">
                                                    <i class="fas fa-thermometer-half me-1 text-info"></i>Refrigerator
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Notes -->
                                <div class="mb-3">
                                    <label for="roomNotes" class="form-label fw-medium">
                                        <i class="fas fa-sticky-note text-secondary me-2"></i>Room Notes
                                    </label>
                                    <textarea class="form-control" id="roomNotes" rows="3"
                                              placeholder="Additional notes, special instructions, or maintenance history..."></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Change History (if available) -->
                <div class="alert alert-light mt-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <i class="fas fa-history me-2"></i>
                            <strong>Last Updated:</strong>
                            <span class="text-muted">@DateTime.Now.ToString("MMMM dd, yyyy HH:mm")</span>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#historySection">
                            <i class="fas fa-chevron-down me-1"></i>View Change History
                        </button>
                    </div>
                    <div class="collapse mt-3" id="historySection">
                        <div class="card card-body">
                            <small class="text-muted">Change history would appear here if implemented.</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Card Footer with Action Buttons -->
            <div class="card-footer bg-light d-flex justify-content-between py-3">
                <div>
                    <a asp-page="./Details" asp-route-id="@Model.Room.RoomId" class="btn btn-outline-secondary">
                        <i class="fas fa-times me-2"></i>Cancel
                    </a>
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
                        <i class="fas fa-trash me-2"></i>Delete
                    </button>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fas fa-save me-2"></i>Save Changes
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- Quick Links -->
    <div class="mt-4">
        <div class="d-flex gap-2">
            <a asp-page="./Details" asp-route-id="@Model.Room.RoomId" class="btn btn-outline-primary btn-sm">
                <i class="fas fa-eye me-1"></i>View Details
            </a>
            <a asp-page="./Index" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-list me-1"></i>Back to Room List
            </a>
            @if (Model.Room.Status == "Available")
            {
                <button type="button" class="btn btn-outline-success btn-sm" data-bs-toggle="modal" data-bs-target="#assignModal">
                    <i class="fas fa-user-plus me-1"></i>Assign Patient
                </button>
            }
            else if (Model.Room.Status == "Occupied")
            {
                <button type="button" class="btn btn-outline-warning btn-sm" data-bs-toggle="modal" data-bs-target="#checkoutModal">
                    <i class="fas fa-user-minus me-1"></i>Check Out Patient
                </button>
            }
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Delete Room</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-danger mb-3">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <strong>Warning:</strong> This action cannot be undone.
                </div>
                <p>Are you sure you want to delete <strong>Room @Model.Room.RoomNumber</strong>?</p>
                <p class="text-muted small">All room information will be permanently removed from the system.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Room.RoomId" class="d-inline">
                    <button type="submit" class="btn btn-danger">Delete Room</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Assign Patient Modal -->
<div class="modal fade" id="assignModal" tabindex="-1" aria-labelledby="assignModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="assignModalLabel">Assign Patient to Room @Model.Room.RoomNumber</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Quickly assign a patient to this room. This will change the room status to "Occupied".</p>
                <div class="mb-3">
                    <label for="patientSelect" class="form-label">Select Patient</label>
                    <select class="form-select" id="patientSelect">
                        <option selected>Choose a patient...</option>
                        <option value="1">John Doe (Waiting for room)</option>
                        <option value="2">Jane Smith (Needs transfer)</option>
                        <option value="3">Robert Johnson (New admission)</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="assignPatient()">Assign Patient</button>
            </div>
        </div>
    </div>
</div>

@functions {
    // Helper function to determine badge class based on status
    public string GetStatusBadgeClass(string status)
    {
        if (string.IsNullOrEmpty(status)) return "secondary";

        return status.ToLower() switch
        {
            "available" => "success",
            "occupied" => "warning",
            "maintenance" => "danger",
            "cleaning" => "info",
            "reserved" => "primary",
            "out of service" => "secondary",
            _ => "secondary"
        };
    }
}

@section Scripts {
    <script>
        // Form validation
        (function () {
            'use strict'
            var forms = document.querySelectorAll('.needs-validation')
            Array.prototype.slice.call(forms)
                .forEach(function (form) {
                    form.addEventListener('submit', function (event) {
                        if (!form.checkValidity()) {
                            event.preventDefault()
                            event.stopPropagation()
                        }
                        form.classList.add('was-validated')
                    }, false)
                })
        })()

        // Set status function
        function setStatus(status) {
            document.getElementById('Room_Status').value = status;

            // Show confirmation message
            const toast = document.createElement('div');
            toast.className = 'toast align-items-center text-white bg-success border-0 position-fixed bottom-0 end-0 m-3';
            toast.setAttribute('role', 'alert');
            toast.innerHTML = `
                <div class="d-flex">
                    <div class="toast-body">
                        <i class="fas fa-check-circle me-2"></i>Status set to: ${status}
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            `;
            document.body.appendChild(toast);

            const bsToast = new bootstrap.Toast(toast);
            bsToast.show();

            setTimeout(() => {
                toast.remove();
            }, 3000);
        }

        // Adjust rate function
        function adjustRate(percentage) {
            const rateInput = document.getElementById('Room_RatePerDay');
            let currentRate = parseFloat(rateInput.value) || 0;

            const newRate = currentRate * (1 + percentage / 100);
            rateInput.value = newRate.toFixed(2);

            // Show confirmation message
            const toast = document.createElement('div');
            toast.className = 'toast align-items-center text-white bg-primary border-0 position-fixed bottom-0 end-0 m-3';
            toast.setAttribute('role', 'alert');
            toast.innerHTML = `
                <div class="d-flex">
                    <div class="toast-body">
                        <i class="fas fa-percentage me-2"></i>Rate adjusted ${percentage > 0 ? '+' : ''}${percentage}%
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            `;
            document.body.appendChild(toast);

            const bsToast = new bootstrap.Toast(toast);
            bsToast.show();

            setTimeout(() => {
                toast.remove();
            }, 3000);
        }

        // Assign patient function
        function assignPatient() {
            const patientSelect = document.getElementById('patientSelect');
            const selectedPatient = patientSelect.options[patientSelect.selectedIndex].text;

            if (patientSelect.value) {
                // Update room status
                document.getElementById('Room_Status').value = 'Occupied';

                // Close modal
                const modal = bootstrap.Modal.getInstance(document.getElementById('assignModal'));
                modal.hide();

                // Show success message
                alert(`Patient ${selectedPatient} assigned to Room @Model.Room.RoomNumber. Status updated to Occupied.`);
            } else {
                alert('Please select a patient.');
            }
        }

        // Initialize department select with search
        document.addEventListener('DOMContentLoaded', function() {
            const departmentSelect = document.querySelector('.department-select');
            if (departmentSelect) {
                // Simple search functionality
                departmentSelect.addEventListener('keyup', function(e) {
                    const searchTerm = e.target.value.toLowerCase();
                    const options = departmentSelect.querySelectorAll('option');

                    options.forEach(option => {
                        const text = option.textContent.toLowerCase();
                        if (text.includes(searchTerm) || option.value === '') {
                            option.style.display = '';
                        } else {
                            option.style.display = 'none';
                        }
                    });
                });
            }

            // Pre-select current room type in dropdown
            const roomTypeSelect = document.getElementById('Room_RoomType');
            const currentRoomType = '@Model.Room.RoomType';
            if (roomTypeSelect && currentRoomType) {
                for (let i = 0; i < roomTypeSelect.options.length; i++) {
                    if (roomTypeSelect.options[i].value === currentRoomType) {
                        roomTypeSelect.selectedIndex = i;
                        break;
                    }
                }
            }

            // Pre-select current status in dropdown
            const statusSelect = document.getElementById('Room_Status');
            const currentStatus = '@Model.Room.Status';
            if (statusSelect && currentStatus) {
                for (let i = 0; i < statusSelect.options.length; i++) {
                    if (statusSelect.options[i].value === currentStatus) {
                        statusSelect.selectedIndex = i;
                        break;
                    }
                }
            }

            // Pre-select current department
            const currentDeptId = '@Model.Room.DepartmentId';
            if (departmentSelect && currentDeptId) {
                for (let i = 0; i < departmentSelect.options.length; i++) {
                    if (departmentSelect.options[i].value === currentDeptId) {
                        departmentSelect.selectedIndex = i;
                        break;
                    }
                }
            }
        });

        // Auto-update capacity warning based on status and capacity
        document.getElementById('Room_Status').addEventListener('change', function() {
            updateCapacityWarning();
        });

        document.getElementById('Room_Capacity').addEventListener('input', function() {
            updateCapacityWarning();
        });

        function updateCapacityWarning() {
            const status = document.getElementById('Room_Status').value;
            const capacity = parseInt(document.getElementById('Room_Capacity').value) || 0;
            const warningDiv = document.querySelector('.alert-warning');

            if (status === 'Occupied' && capacity > 0) {
                if (!warningDiv) {
                    // Create warning if it doesn't exist
                    const warning = document.createElement('div');
                    warning.className = 'alert alert-warning mt-3';
                    warning.innerHTML = `
                        <div class="d-flex align-items-center">
                            <i class="fas fa-exclamation-triangle me-3 fa-lg"></i>
                            <div>
                                <h6 class="alert-heading mb-1">Occupied Room Warning</h6>
                                <p class="mb-0">This room is currently occupied. Changing capacity may affect current patient accommodations.</p>
                            </div>
                        </div>
                    `;
                    // Insert after the quick actions card body
                    const quickActionsCard = document.querySelector('.card-body .row .col-md-6').parentElement.parentElement;
                    quickActionsCard.appendChild(warning);
                }
            } else if (warningDiv) {
                warningDiv.remove();
            }
        }
    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
