@page
@model Cortex.Pages.Room.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_DashboardLayout.cshtml";
}

<h1>Index</h1>

<p>
    <a asp-page="Create" class="px-3 py-2 btn-outline-primary  rounded"> <i class="fa-solid fa-user-plus"></i> Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Room[0].RoomNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Room[0].RoomType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Room[0].Capacity)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Room[0].Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Room[0].RatePerDay)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Room[0].Department)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Room) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.RoomNumber)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RoomType)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Capacity)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Status)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RatePerDay)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Department.DepartmentName)
            </td>
            <td>
                <a class="btn btn-sm btn-outline-secondary me-2" asp-page="./Edit" asp-route-id="@item.RoomId"> <i class="fas fa-edit"></i> Edit</a>
                <a class="btn btn-sm btn-outline-primary me-2" asp-page="./Details" asp-route-id="@item.RoomId"> <i class="fas fa-eye"></i> Details</a>
                <a class="btn btn-sm btn-outline-danger" asp-page="./Delete" asp-route-id="@item.RoomId"><i class="fas fa-trash"></i> Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
