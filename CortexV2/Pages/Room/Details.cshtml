@page
@model Cortex.Pages.Room.DetailsModel

@{
    ViewData["Title"] = "Room Details";
    Layout = "~/Pages/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid py-4">
    <!-- Header with title and action buttons -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0">Room Details</h1>
            <p class="text-muted mb-0">View detailed information about room @Model.Room.RoomNumber</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="./Edit" asp-route-id="@Model.Room.RoomId" class="btn btn-primary">
                <i class="fas fa-edit me-2"></i>Edit Room
            </a>
            <a asp-page="./Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Back to List
            </a>
        </div>
    </div>

    <!-- Main content card -->
    <div class="card shadow-sm">
        <div class="card-header bg-light py-3">
            <div class="d-flex align-items-center">
                <div class="me-3">
                    <div class="icon-shape icon-xl bg-primary bg-gradient text-white rounded-circle d-flex align-items-center justify-content-center">
                        <i class="fas fa-door-closed fa-lg"></i>
                    </div>
                </div>
                <div>
                    <h2 class="h4 mb-0">Room @Model.Room.RoomNumber</h2>
                    <div class="d-flex align-items-center mt-1">
                        <span class="badge bg-@GetStatusBadgeClass(Model.Room.Status) me-2">@Model.Room.Status</span>
                        <span class="text-muted">ID: @Model.Room.RoomId</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-body">
            <div class="row">
                <!-- Room Information Column -->
                <div class="col-md-6">
                    <div class="card mb-4 border">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">Room Information</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="form-label text-muted small mb-1">Room Number</label>
                                <div class="d-flex align-items-center">
                                    <div class="icon-shape icon-sm bg-primary bg-opacity-10 text-primary rounded-circle me-2 d-flex align-items-center justify-content-center">
                                        <i class="fas fa-hashtag fa-xs"></i>
                                    </div>
                                    <p class="mb-0 fw-medium h5">@Model.Room.RoomNumber</p>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label text-muted small mb-1">Room Type</label>
                                <div class="d-flex align-items-center">
                                    <div class="icon-shape icon-sm bg-info bg-opacity-10 text-info rounded-circle me-2 d-flex align-items-center justify-content-center">
                                        <i class="fas fa-door-open fa-xs"></i>
                                    </div>
                                    <div>
                                        <p class="mb-0 fw-medium">@Model.Room.RoomType</p>
                                        <small class="text-muted">@GetRoomTypeDescription(Model.Room.RoomType)</small>
                                    </div>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label text-muted small mb-1">Capacity</label>
                                <div class="d-flex align-items-center">
                                    <div class="icon-shape icon-sm bg-success bg-opacity-10 text-success rounded-circle me-2 d-flex align-items-center justify-content-center">
                                        <i class="fas fa-users fa-xs"></i>
                                    </div>
                                    <div>
                                        <p class="mb-0 fw-medium">@Model.Room.Capacity person(s)</p>
                                        <small class="text-muted">Maximum occupancy</small>
                                    </div>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label text-muted small mb-1">Rate Per Day</label>
                                <div class="d-flex align-items-center">
                                    <div class="icon-shape icon-sm bg-warning bg-opacity-10 text-warning rounded-circle me-2 d-flex align-items-center justify-content-center">
                                        <i class="fas fa-dollar-sign fa-xs"></i>
                                    </div>
                                    <div>
                                        <p class="mb-0 fw-medium h5 text-success">$@(Model.Room.RatePerDay?.ToString("F2") ?? "0.00")</p>
                                        <small class="text-muted">Daily rate</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Department & Status Column -->
                <div class="col-md-6">
                    <div class="card mb-4 border">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">Department & Status</h5>
                        </div>
                        <div class="card-body">
                            <!-- Department Information -->
                            <div class="mb-4">
                                <label class="form-label text-muted small mb-1">Department</label>
                                @if (Model.Room.Department != null)
                                {
                                    <div class="d-flex align-items-center">
                                        <div class="icon-shape icon-sm bg-info bg-opacity-10 text-info rounded-circle me-2 d-flex align-items-center justify-content-center">
                                            <i class="fas fa-building fa-xs"></i>
                                        </div>
                                        <div>
                                            <p class="mb-0 fw-medium">@Model.Room.Department.DepartmentName</p>
                                            <small class="text-muted">Department ID: @Model.Room.Department.DepartmentId</small>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex align-items-center">
                                        <div class="icon-shape icon-sm bg-secondary bg-opacity-10 text-secondary rounded-circle me-2 d-flex align-items-center justify-content-center">
                                            <i class="fas fa-building fa-xs"></i>
                                        </div>
                                        <div>
                                            <p class="mb-0 fw-medium text-muted">No department assigned</p>
                                            <small class="text-muted">Assign a department in edit mode</small>
                                        </div>
                                    </div>
                                }
                            </div>

                            <!-- Status Information -->
                            <div class="mb-3">
                                <label class="form-label text-muted small mb-1">Current Status</label>
                                <div class="d-flex align-items-center mb-3">
                                    <div class="icon-shape icon-sm bg-@GetStatusBadgeClass(Model.Room.Status) bg-opacity-10 text-@GetStatusBadgeClass(Model.Room.Status) rounded-circle me-2 d-flex align-items-center justify-content-center">
                                        <i class="fas fa-@GetStatusIcon(Model.Room.Status) fa-xs"></i>
                                    </div>
                                    <div>
                                        <p class="mb-0 fw-medium">@Model.Room.Status</p>
                                        <small class="text-muted">Room availability</small>
                                    </div>
                                </div>

                                <!-- Status Indicator -->
                                <div class="status-indicator">
                                    <div class="d-flex justify-content-between mb-1">
                                        <small class="text-muted">Status Indicator</small>
                                        <small class="fw-medium">@GetStatusPercentage(Model.Room.Status)%</small>
                                    </div>
                                    <div class="progress" style="height: 8px;">
                                        <div class="progress-bar bg-@GetStatusBadgeClass(Model.Room.Status)" role="progressbar"
                                             style="width: @GetStatusPercentage(Model.Room.Status)%"
                                             aria-valuenow="@GetStatusPercentage(Model.Room.Status)"
                                             aria-valuemin="0"
                                             aria-valuemax="100"></div>
                                    </div>
                                    <div class="d-flex justify-content-between mt-1">
                                        <small class="text-muted">Available</small>
                                        <small class="text-muted">Occupied</small>
                                    </div>
                                </div>
                            </div>

                            <!-- Quick Actions -->
                            <div class="mt-4">
                                <label class="form-label text-muted small mb-2">Quick Actions</label>
                                <div class="d-flex flex-wrap gap-2">
                                    @if (Model.Room.Status == "Available")
                                    {
                                        <button class="btn btn-sm btn-outline-success" data-bs-toggle="modal" data-bs-target="#assignModal">
                                            <i class="fas fa-user-plus me-1"></i>Assign Patient
                                        </button>
                                    }
                                    else if (Model.Room.Status == "Occupied")
                                    {
                                        <button class="btn btn-sm btn-outline-warning" data-bs-toggle="modal" data-bs-target="#checkoutModal">
                                            <i class="fas fa-user-minus me-1"></i>Check Out
                                        </button>
                                    }

                                    <button class="btn btn-sm btn-outline-info" data-bs-toggle="modal" data-bs-target="#maintenanceModal">
                                        <i class="fas fa-tools me-1"></i>Maintenance
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#notesModal">
                                        <i class="fas fa-sticky-note me-1"></i>Add Notes
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Admissions History (if any) -->
                @if (Model.Room.Admissions != null && Model.Room.Admissions.Any())
                {
                    <div class="col-12">
                        <div class="card border">
                            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">Recent Admissions</h5>
                                <span class="badge bg-primary">@Model.Room.Admissions.Count() total</span>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead>
                                            <tr>
                                                <th>Admission ID</th>
                                                <th>Patient</th>
                                                <th>Admission Date</th>
                                                <th>Discharge Date</th>
                                                <th>Status</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var admission in Model.Room.Admissions.Take(5))
                                            {
                                                <tr>
                                                    <td>#@admission.AdmissionId</td>
                                                    <td>Patient @admission.PatientId</td>
                                                    <td>@admission.AdmissionDate.ToString("MMM dd, yyyy")</td>
                                                    <td>@(admission.DischargeDate?.ToString("MMM dd, yyyy") ?? "Not discharged")</td>
                                                    <td>
                                                        <span class="badge bg-@(admission.DischargeDate == null ? "success" : "secondary")">
                                                            @(admission.DischargeDate == null ? "Active" : "Discharged")
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <a href="/Admissions/Details/@admission.AdmissionId" class="btn btn-sm btn-outline-primary">
                                                            <i class="fas fa-eye"></i>
                                                        </a>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                @if (Model.Room.Admissions.Count() > 5)
                                {
                                    <div class="text-center mt-3">
                                        <a href="#" class="btn btn-sm btn-outline-secondary">
                                            View All @Model.Room.Admissions.Count() Admissions
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="col-12">
                        <div class="card border">
                            <div class="card-header bg-light">
                                <h5 class="mb-0">Admissions History</h5>
                            </div>
                            <div class="card-body">
                                <div class="text-center py-4">
                                    <div class="icon-shape icon-lg bg-light text-muted rounded-circle d-inline-flex align-items-center justify-content-center mb-3">
                                        <i class="fas fa-history fa-lg"></i>
                                    </div>
                                    <h5 class="text-muted">No Admissions Yet</h5>
                                    <p class="text-muted mb-0">This room has no admission history.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Card Footer with action buttons -->
        <div class="card-footer bg-light d-flex justify-content-between">
            <div>
                <a asp-page="./Index" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-2"></i>Back to Room List
                </a>
            </div>
            <div class="d-flex gap-2">
                <a asp-page="./Edit" asp-route-id="@Model.Room.RoomId" class="btn btn-primary">
                    <i class="fas fa-edit me-2"></i>Edit Room
                </a>
                <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
                    <i class="fas fa-trash me-2"></i>Delete
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Assign Patient Modal -->
<div class="modal fade" id="assignModal" tabindex="-1" aria-labelledby="assignModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="assignModalLabel">Assign Patient to Room @Model.Room.RoomNumber</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Assign a patient to this room. This will change the room status to "Occupied".</p>
                <div class="mb-3">
                    <label for="patientSelect" class="form-label">Select Patient</label>
                    <select class="form-select" id="patientSelect">
                        <option selected>Choose a patient...</option>
                        <option value="1">John Doe (Room 101)</option>
                        <option value="2">Jane Smith (Room 102)</option>
                        <option value="3">Robert Johnson (Room 103)</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label for="assignNotes" class="form-label">Notes (Optional)</label>
                    <textarea class="form-control" id="assignNotes" rows="2" placeholder="Additional notes..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary">Assign Patient</button>
            </div>
        </div>
    </div>
</div>

<!-- Check Out Modal -->
<div class="modal fade" id="checkoutModal" tabindex="-1" aria-labelledby="checkoutModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="checkoutModalLabel">Check Out from Room @Model.Room.RoomNumber</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Check out the current patient from this room. This will change the room status to "Available".</p>
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>
                    The room will be marked for cleaning before being available for new patients.
                </div>
                <div class="mb-3">
                    <label for="checkoutReason" class="form-label">Reason for Check Out</label>
                    <select class="form-select" id="checkoutReason">
                        <option selected>Select reason...</option>
                        <option value="discharge">Patient Discharged</option>
                        <option value="transfer">Patient Transferred</option>
                        <option value="other">Other</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning">Check Out</button>
            </div>
        </div>
    </div>
</div>

<!-- Maintenance Modal -->
<div class="modal fade" id="maintenanceModal" tabindex="-1" aria-labelledby="maintenanceModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="maintenanceModalLabel">Request Maintenance for Room @Model.Room.RoomNumber</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="maintenanceType" class="form-label">Maintenance Type</label>
                    <select class="form-select" id="maintenanceType">
                        <option selected>Select type...</option>
                        <option value="cleaning">Cleaning</option>
                        <option value="repair">Repair</option>
                        <option value="inspection">Inspection</option>
                        <option value="other">Other</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label for="maintenanceDescription" class="form-label">Description</label>
                    <textarea class="form-control" id="maintenanceDescription" rows="3" placeholder="Describe the maintenance needed..."></textarea>
                </div>
                <div class="mb-3">
                    <label for="maintenancePriority" class="form-label">Priority</label>
                    <select class="form-select" id="maintenancePriority">
                        <option value="low">Low</option>
                        <option value="medium" selected>Medium</option>
                        <option value="high">High</option>
                        <option value="urgent">Urgent</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary">Submit Request</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Delete Room</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-danger mb-3">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <strong>Warning:</strong> This action cannot be undone.
                </div>
                <p>Are you sure you want to delete <strong>Room @Model.Room.RoomNumber</strong>?</p>
                <p class="text-muted small">
                    This will permanently remove the room from the system.
                    @if (Model.Room.Admissions != null && Model.Room.Admissions.Any())
                    {
                        <span class="text-danger">There are @Model.Room.Admissions.Count() admissions associated with this room.</span>
                    }
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Room.RoomId" class="d-inline">
                    <button type="submit" class="btn btn-danger">Delete Room</button>
                </form>
            </div>
        </div>
    </div>
</div>

@functions {
    // Helper function to determine badge class based on status
    public string GetStatusBadgeClass(string status)
    {
        if (string.IsNullOrEmpty(status)) return "secondary";

        return status.ToLower() switch
        {
            "available" => "success",
            "occupied" => "warning",
            "maintenance" => "danger",
            "cleaning" => "info",
            "reserved" => "primary",
            _ => "secondary"
        };
    }

    // Helper function to get status icon
    public string GetStatusIcon(string status)
    {
        if (string.IsNullOrEmpty(status)) return "question-circle";

        return status.ToLower() switch
        {
            "available" => "check-circle",
            "occupied" => "user",
            "maintenance" => "tools",
            "cleaning" => "broom",
            "reserved" => "clock",
            _ => "question-circle"
        };
    }

    // Helper function to get status percentage for progress bar
    public int GetStatusPercentage(string status)
    {
        if (string.IsNullOrEmpty(status)) return 0;

        return status.ToLower() switch
        {
            "available" => 100,
            "occupied" => 25,
            "maintenance" => 50,
            "cleaning" => 75,
            "reserved" => 10,
            _ => 0
        };
    }

    // Helper function to get room type description
    public string GetRoomTypeDescription(string roomType)
    {
        if (string.IsNullOrEmpty(roomType)) return "";

        return roomType.ToLower() switch
        {
            "private" => "Private room with single bed",
            "semi-private" => "Semi-private with 2 beds",
            "ward" => "Ward with multiple beds",
            "icu" => "Intensive Care Unit",
            "emergency" => "Emergency Room",
            "operation" => "Operating Room",
            "delivery" => "Delivery Room",
            "isolation" => "Isolation Room",
            _ => "Standard hospital room"
        };
    }
}
