@page
@model Cortex.Pages.Medication.DetailsModel

@{
    ViewData["Title"] = "Medication Details";
    Layout = "~/Pages/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid px-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 text-gray-800 mb-1">Medication Details</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a asp-page="/Dashboard/Index">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-page="Index">Medications</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Details</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Back to List
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-8 col-lg-10 mx-auto">
            <!-- Main Details Card -->
            <div class="card shadow border-0 mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-pills me-2"></i>@Model.Medication.Name
                            @if (!string.IsNullOrEmpty(Model.Medication.GenericName))
                            {
                                <span class="fw-normal fs-6">(@Model.Medication.GenericName)</span>
                            }
                        </h5>
                        <span class="badge bg-light text-dark fs-6">
                            ID: #@Model.Medication.MedicationId.ToString("D5")
                        </span>
                    </div>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4">
                        <!-- Stock Status Card -->
                        <div class="col-12">
                            <div class="card border">
                                <div class="card-body">
                                    <div class="row align-items-center">
                                        <div class="col-md-4">
                                            <div class="d-flex align-items-center">
                                                <div class="me-3">
                                                    <i class="fas fa-boxes fa-2x text-primary"></i>
                                                </div>
                                                <div>
                                                    <h6 class="mb-0">Current Stock</h6>
                                                    <h2 class="mb-0 @GetStockColorClass(Model.Medication.CurrentStock, Model.Medication.ReorderLevel)">
                                                        @(Model.Medication.CurrentStock?.ToString() ?? "0")
                                                    </h2>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="d-flex align-items-center">
                                                <div class="me-3">
                                                    <i class="fas fa-exclamation-triangle fa-2x text-warning"></i>
                                                </div>
                                                <div>
                                                    <h6 class="mb-0">Reorder Level</h6>
                                                    <h3 class="mb-0">@(Model.Medication.ReorderLevel?.ToString() ?? "Not Set")</h3>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="d-flex align-items-center">
                                                <div class="me-3">
                                                    <i class="fas fa-tag fa-2x text-success"></i>
                                                </div>
                                                <div>
                                                    <h6 class="mb-0">Unit Price</h6>
                                                    <h3 class="mb-0 text-success">$@Model.Medication.UnitPrice.ToString("F2")</h3>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Basic Information -->
                        <div class="col-md-6">
                            <div class="card border h-100">
                                <div class="card-header bg-light py-3">
                                    <h6 class="mb-0">
                                        <i class="fas fa-info-circle me-2 text-primary"></i>Basic Information
                                    </h6>
                                </div>
                                <div class="card-body">
                                    <dl class="row mb-0">
                                        <dt class="col-sm-5 text-muted">Manufacturer</dt>
                                        <dd class="col-sm-7">
                                            @if (!string.IsNullOrEmpty(Model.Medication.Manufacturer))
                                            {
                                                <span class="fw-semibold">@Model.Medication.Manufacturer</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Not specified</span>
                                            }
                                        </dd>

                                        <dt class="col-sm-5 text-muted">Category</dt>
                                        <dd class="col-sm-7">
                                            @if (!string.IsNullOrEmpty(Model.Medication.Category))
                                            {
                                                <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25">
                                                    @Model.Medication.Category
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Not categorized</span>
                                            }
                                        </dd>

                                        <dt class="col-sm-5 text-muted">Unit Type</dt>
                                        <dd class="col-sm-7">
                                            @if (!string.IsNullOrEmpty(Model.Medication.UnitType))
                                            {
                                                <span class="fw-semibold">@Model.Medication.UnitType</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Not specified</span>
                                            }
                                        </dd>

                                        <dt class="col-sm-5 text-muted">Status</dt>
                                        <dd class="col-sm-7">
                                            @if (!string.IsNullOrEmpty(Model.Medication.Status))
                                            {
                                                <span class="badge @GetStatusBadgeClass(Model.Medication.Status)">
                                                    @Model.Medication.Status
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Unknown</span>
                                            }
                                        </dd>
                                    </dl>
                                </div>
                            </div>
                        </div>

                        <!-- Pricing & Inventory -->
                        <div class="col-md-6">
                            <div class="card border h-100">
                                <div class="card-header bg-light py-3">
                                    <h6 class="mb-0">
                                        <i class="fas fa-chart-line me-2 text-primary"></i>Inventory Details
                                    </h6>
                                </div>
                                <div class="card-body">
                                    <dl class="row mb-0">
                                        <dt class="col-sm-5 text-muted">Medication ID</dt>
                                        <dd class="col-sm-7 fw-semibold">#@Model.Medication.MedicationId.ToString("D5")</dd>

                                        <dt class="col-sm-5 text-muted">Brand Name</dt>
                                        <dd class="col-sm-7 fw-semibold">@Model.Medication.Name</dd>

                                        <dt class="col-sm-5 text-muted">Generic Name</dt>
                                        <dd class="col-sm-7">
                                            @if (!string.IsNullOrEmpty(Model.Medication.GenericName))
                                            {
                                                <span class="fw-semibold">@Model.Medication.GenericName</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Not specified</span>
                                            }
                                        </dd>

                                        <dt class="col-sm-5 text-muted">Created</dt>
                                        <dd class="col-sm-7">
                                            <span class="text-muted">System Entry</span>
                                        </dd>
                                    </dl>
                                </div>
                            </div>
                        </div>

                        <!-- Description -->
                        @if (!string.IsNullOrEmpty(Model.Medication.Description))
                        {
                            <div class="col-12">
                                <div class="card border">
                                    <div class="card-header bg-light py-3">
                                        <h6 class="mb-0">
                                            <i class="fas fa-file-alt me-2 text-primary"></i>Description
                                        </h6>
                                    </div>
                                    <div class="card-body">
                                        <p class="mb-0">@Model.Medication.Description</p>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- Stock Alert Section -->
                        @if (Model.Medication.CurrentStock.HasValue && Model.Medication.ReorderLevel.HasValue)
                        {
                            <div class="col-12">
                                <div class="card border @GetStockAlertClass(Model.Medication.CurrentStock.Value, Model.Medication.ReorderLevel.Value)">
                                    <div class="card-body">
                                        <div class="d-flex align-items-center">
                                            <div class="flex-shrink-0 me-3">
                                                <i class="fas @GetStockAlertIcon(Model.Medication.CurrentStock.Value, Model.Medication.ReorderLevel.Value) fa-2x"></i>
                                            </div>
                                            <div class="flex-grow-1">
                                                <h5 class="mb-1">@GetStockAlertTitle(Model.Medication.CurrentStock.Value, Model.Medication.ReorderLevel.Value)</h5>
                                                <p class="mb-0">@GetStockAlertMessage(Model.Medication.CurrentStock.Value, Model.Medication.ReorderLevel.Value)</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- Action Buttons -->
                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center border-top pt-4">
                                <div>
                                    <a asp-page="Index" class="btn btn-outline-secondary">
                                        <i class="fas fa-list me-2"></i>View All Medications
                                    </a>
                                </div>
                                <div class="d-flex gap-2">
                                    <a asp-page="./Edit" asp-route-id="@Model.Medication.MedicationId"
                                       class="btn btn-warning">
                                        <i class="fas fa-edit me-2"></i>Edit Medication
                                    </a>
                                    <a href="#" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
                                        <i class="fas fa-trash me-2"></i>Delete
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Stats Overview -->
            <div class="row">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body text-center">
                            <div class="mb-3">
                                <i class="fas fa-prescription-bottle-alt fa-3x text-primary"></i>
                            </div>
                            <h4 class="card-title">Available Stock</h4>
                            <h2 class="display-6 fw-bold @GetStockColorClass(Model.Medication.CurrentStock, Model.Medication.ReorderLevel)">
                                @(Model.Medication.CurrentStock?.ToString() ?? "0")
                            </h2>
                            <p class="text-muted">Units in inventory</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body text-center">
                            <div class="mb-3">
                                <i class="fas fa-money-bill-wave fa-3x text-success"></i>
                            </div>
                            <h4 class="card-title">Unit Price</h4>
                            <h2 class="display-6 fw-bold text-success">
                                $@Model.Medication.UnitPrice.ToString("F2")
                            </h2>
                            <p class="text-muted">Price per @(Model.Medication.UnitType?.ToLower() ?? "unit")</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body text-center">
                            <div class="mb-3">
                                <i class="fas fa-warehouse fa-3x text-info"></i>
                            </div>
                            <h4 class="card-title">Reorder Level</h4>
                            <h2 class="display-6 fw-bold text-warning">
                                @(Model.Medication.ReorderLevel?.ToString() ?? "N/A")
                            </h2>
                            <p class="text-muted">Low stock threshold</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">
                    <i class="fas fa-exclamation-triangle text-danger me-2"></i>Confirm Deletion
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-danger">
                    <h6 class="alert-heading">Warning!</h6>
                    <p class="mb-0">You are about to delete <strong>@Model.Medication.Name</strong>. This action cannot be undone.</p>
                </div>
                <p>Are you sure you want to delete this medication? This will remove all associated prescription details.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Medication.MedicationId">
                    <button type="submit" class="btn btn-danger">Delete Medication</button>
                </form>
            </div>
        </div>
    </div>
</div>

@functions {
    private string GetStockColorClass(int? currentStock, int? reorderLevel)
    {
        if (!currentStock.HasValue || !reorderLevel.HasValue || reorderLevel == 0)
            return "text-dark";

        if (currentStock.Value <= 0)
            return "text-danger";
        if (currentStock.Value <= reorderLevel.Value)
            return "text-warning";
        return "text-success";
    }

    private string GetStatusBadgeClass(string? status)
    {
        return status?.ToLower() switch
        {
            "active" => "bg-success",
            "inactive" => "bg-secondary",
            "discontinued" => "bg-danger",
            "out of stock" => "bg-warning",
            "low stock" => "bg-warning",
            "available" => "bg-success",
            _ => "bg-secondary"
        };
    }

    private string GetStockAlertClass(int currentStock, int reorderLevel)
    {
        if (currentStock <= 0) return "border-danger bg-danger bg-opacity-10";
        if (currentStock <= reorderLevel) return "border-warning bg-warning bg-opacity-10";
        return "border-success bg-success bg-opacity-10";
    }

    private string GetStockAlertIcon(int currentStock, int reorderLevel)
    {
        if (currentStock <= 0) return "fa-times-circle text-danger";
        if (currentStock <= reorderLevel) return "fa-exclamation-circle text-warning";
        return "fa-check-circle text-success";
    }

    private string GetStockAlertTitle(int currentStock, int reorderLevel)
    {
        if (currentStock <= 0) return "Out of Stock";
        if (currentStock <= reorderLevel) return "Low Stock Alert";
        return "Stock Level Good";
    }

    private string GetStockAlertMessage(int currentStock, int reorderLevel)
    {
        if (currentStock <= 0) return "This medication is currently out of stock. Consider reordering immediately.";
        if (currentStock <= reorderLevel) return $"Stock level ({currentStock}) is at or below the reorder threshold ({reorderLevel}). Consider reordering soon.";
        return $"Stock level ({currentStock}) is above the reorder threshold ({reorderLevel}). No immediate action needed.";
    }
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize tooltips
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });

            // Print functionality
            document.getElementById('printBtn')?.addEventListener('click', function() {
                window.print();
            });
        });
    </script>
}