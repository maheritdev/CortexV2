@page
@model Cortex.Pages.Appointment.DetailsModel

@{
    ViewData["Title"] = "Appointment Details";
    Layout = "~/Pages/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-page="/Index">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-page="Index">Appointments</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Details</li>
                </ol>
            </nav>
            <h1 class="h2 mb-0">Appointment Details</h1>
            <p class="text-muted">View complete appointment information</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Back to List
            </a>
            <a asp-page="./Edit" asp-route-id="@Model.Appointment.AppointmentId" class="btn btn-primary">
                <i class="fas fa-edit me-2"></i>Edit Appointment
            </a>
        </div>
    </div>

    <div class="row">
        <!-- Main Appointment Details -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="fas fa-calendar-check me-2"></i>
                        Appointment #@Model.Appointment.AppointmentId
                    </h5>
                    <span class="badge @GetStatusBadgeClass(Model.Appointment.Status) fs-6">
                        @Model.Appointment.Status
                    </span>
                </div>
                <div class="card-body">
                    <div class="row g-4">
                        <!-- Appointment Information -->
                        <div class="col-md-6">
                            <div class="mb-4">
                                <label class="form-label fw-semibold text-muted">
                                    <i class="fas fa-calendar-day me-1"></i>Appointment Date
                                </label>
                                <div class="d-flex align-items-center">
                                    <div class="flex-shrink-0">
                                        <div class="avatar avatar-sm rounded-circle bg-primary text-white d-flex align-items-center justify-content-center">
                                            <i class="fas fa-calendar"></i>
                                        </div>
                                    </div>
                                    <div class="flex-grow-1 ms-3">
                                        <h6 class="mb-0">@Model.Appointment.AppointmentDate.ToString("dddd, MMMM dd, yyyy")</h6>
                                        <small class="text-muted">
                                            <i class="fas fa-clock me-1"></i>
                                            @Model.Appointment.StartTime.ToString("hh:mm tt") - @Model.Appointment.EndTime.ToString("hh:mm tt")
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Duration -->
                        <div class="col-md-6">
                            <div class="mb-4">
                                <label class="form-label fw-semibold text-muted">
                                    <i class="fas fa-clock me-1"></i>Duration
                                </label>
                                <div class="card bg-light border">
                                    <div class="card-body text-center py-3">
                                        <h4 class="mb-0 text-primary">
                                            @GetDuration(Model.Appointment.StartTime, Model.Appointment.EndTime)
                                        </h4>
                                        <small class="text-muted">Total Appointment Time</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Patient Information -->
                        <div class="col-md-6">
                            <div class="card border h-100">
                                <div class="card-header bg-light">
                                    <h6 class="mb-0"><i class="fas fa-user-injured me-2"></i>Patient Information</h6>
                                </div>
                                <div class="card-body">
                                    <div class="d-flex align-items-center mb-3">
                                        <div class="flex-shrink-0">
                                            <div class="avatar avatar-md rounded-circle bg-success text-white d-flex align-items-center justify-content-center">
                                                <i class="fas fa-user"></i>
                                            </div>
                                        </div>
                                        <div class="flex-grow-1 ms-3">
                                            <h5 class="mb-0">@Model.PatientName</h5>
                                            <small class="text-muted">Patient ID: @Model.Appointment.PatientId</small>
                                        </div>
                                    </div>
                                    <div class="small">
                                        <div class="d-flex justify-content-between mb-1">
                                            <span class="text-muted">Age:</span>
                                            <span class="fw-medium">@Model.PatientAge</span>
                                        </div>
                                        <div class="d-flex justify-content-between mb-1">
                                            <span class="text-muted">Gender:</span>
                                            <span class="fw-medium">@Model.PatientGender</span>
                                        </div>
                                        <div class="d-flex justify-content-between">
                                            <span class="text-muted">Contact:</span>
                                            <span class="fw-medium">@Model.PatientPhone</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Doctor Information -->
                        <div class="col-md-6">
                            <div class="card border h-100">
                                <div class="card-header bg-light">
                                    <h6 class="mb-0"><i class="fas fa-user-md me-2"></i>Doctor Information</h6>
                                </div>
                                <div class="card-body">
                                    <div class="d-flex align-items-center mb-3">
                                        <div class="flex-shrink-0">
                                            <div class="avatar avatar-md rounded-circle bg-info text-white d-flex align-items-center justify-content-center">
                                                <i class="fas fa-stethoscope"></i>
                                            </div>
                                        </div>
                                        <div class="flex-grow-1 ms-3">
                                            <h5 class="mb-0">@Model.DoctorName</h5>
                                            <small class="text-muted">Doctor ID: @Model.Appointment.DoctorId</small>
                                        </div>
                                    </div>
                                    <div class="small">
                                        <div class="d-flex justify-content-between mb-1">
                                            <span class="text-muted">Specialization:</span>
                                            <span class="fw-medium">@Model.DoctorSpecialization</span>
                                        </div>
                                        <div class="d-flex justify-content-between mb-1">
                                            <span class="text-muted">Department:</span>
                                            <span class="fw-medium">@Model.DoctorDepartment</span>
                                        </div>
                                        <div class="d-flex justify-content-between">
                                            <span class="text-muted">Contact:</span>
                                            <span class="fw-medium">@Model.DoctorPhone</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Reason for Visit -->
                        <div class="col-12">
                            <div class="card border">
                                <div class="card-header bg-light">
                                    <h6 class="mb-0"><i class="fas fa-comment-medical me-2"></i>Reason for Visit</h6>
                                </div>
                                <div class="card-body">
                                    <p class="mb-0">@(string.IsNullOrEmpty(Model.Appointment.Reason) ? "No reason provided" : Model.Appointment.Reason)</p>
                                </div>
                            </div>
                        </div>

                        <!-- Notes -->
                        <div class="col-12">
                            <div class="card border">
                                <div class="card-header bg-light">
                                    <h6 class="mb-0"><i class="fas fa-notes-medical me-2"></i>Additional Notes</h6>
                                </div>
                                <div class="card-body">
                                    <p class="mb-0">@(string.IsNullOrEmpty(Model.Appointment.Notes) ? "No additional notes" : Model.Appointment.Notes)</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar - Metadata & Actions -->
        <div class="col-lg-4">
            <!-- Creation Information -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-info text-white">
                    <h6 class="mb-0"><i class="fas fa-info-circle me-2"></i>Appointment Metadata</h6>
                </div>
                <div class="card-body">
                    <div class="list-group list-group-flush">
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span class="fw-medium">Appointment ID:</span>
                            <span class="badge bg-secondary">@Model.Appointment.AppointmentId</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span class="fw-medium">Created Date:</span>
                            <span>@Model.Appointment.CreatedDate?.ToString("MMM dd, yyyy HH:mm")</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span class="fw-medium">Created By:</span>
                            <span>@Model.CreatedByName</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span class="fw-medium">Last Updated:</span>
                            <span>@(Model.Appointment.CreatedDate?.ToString("MMM dd, yyyy HH:mm") ?? "Never")</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light">
                    <h6 class="mb-0"><i class="fas fa-bolt me-2"></i>Quick Actions</h6>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-page="./Edit" asp-route-id="@Model.Appointment.AppointmentId" class="btn btn-primary">
                            <i class="fas fa-edit me-2"></i>Edit Appointment
                        </a>

                        @if (Model.Appointment.Status != "Cancelled" && Model.Appointment.Status != "Completed")
                        {
                            <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#rescheduleModal">
                                <i class="fas fa-calendar-alt me-2"></i>Reschedule
                            </button>

                            <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#cancelModal">
                                <i class="fas fa-times me-2"></i>Cancel Appointment
                            </button>
                        }

                        <a href="#" class="btn btn-outline-info">
                            <i class="fas fa-print me-2"></i>Print Details
                        </a>

                        <a href="#" class="btn btn-outline-success">
                            <i class="fas fa-envelope me-2"></i>Send Reminder
                        </a>
                    </div>
                </div>
            </div>

            <!-- Status Timeline -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light">
                    <h6 class="mb-0"><i class="fas fa-history me-2"></i>Status Timeline</h6>
                </div>
                <div class="card-body">
                    <div class="timeline">
                        <div class="timeline-item @(Model.Appointment.Status == "Scheduled" ? "active" : "")">
                            <div class="timeline-marker bg-primary"></div>
                            <div class="timeline-content">
                                <h6 class="mb-0">Scheduled</h6>
                                <small class="text-muted">@Model.Appointment.CreatedDate?.ToString("MMM dd, yyyy")</small>
                            </div>
                        </div>
                        <div class="timeline-item @(Model.Appointment.Status == "Confirmed" ? "active" : "")">
                            <div class="timeline-marker bg-info"></div>
                            <div class="timeline-content">
                                <h6 class="mb-0">Confirmed</h6>
                                <small class="text-muted">Patient confirmed</small>
                            </div>
                        </div>
                        <div class="timeline-item @(Model.Appointment.Status == "In Progress" ? "active" : "")">
                            <div class="timeline-marker bg-warning"></div>
                            <div class="timeline-content">
                                <h6 class="mb-0">In Progress</h6>
                                <small class="text-muted">Appointment started</small>
                            </div>
                        </div>
                        <div class="timeline-item @(Model.Appointment.Status == "Completed" ? "active" : "")">
                            <div class="timeline-marker bg-success"></div>
                            <div class="timeline-content">
                                <h6 class="mb-0">Completed</h6>
                                <small class="text-muted">Appointment finished</small>
                            </div>
                        </div>
                        <div class="timeline-item @(Model.Appointment.Status == "Cancelled" ? "active" : "")">
                            <div class="timeline-marker bg-danger"></div>
                            <div class="timeline-content">
                                <h6 class="mb-0">Cancelled</h6>
                                <small class="text-muted">Appointment cancelled</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Cancel Appointment Modal -->
<div class="modal fade" id="cancelModal" tabindex="-1" aria-labelledby="cancelModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="cancelModalLabel">
                    <i class="fas fa-exclamation-triangle text-warning me-2"></i>
                    Cancel Appointment
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <strong>Warning:</strong> Are you sure you want to cancel this appointment?
                </div>
                <p>This action cannot be undone. The following will happen:</p>
                <ul>
                    <li>Appointment status will be set to "Cancelled"</li>
                    <li>Patient and doctor will be notified</li>
                    <li>Time slot will become available for other appointments</li>
                </ul>
                <div class="form-group mt-3">
                    <label for="cancellationReason" class="form-label">Reason for cancellation</label>
                    <textarea class="form-control" id="cancellationReason" rows="3"
                              placeholder="Please provide a reason for cancellation..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-danger" onclick="cancelAppointment()">
                    <i class="fas fa-ban me-1"></i>Cancel Appointment
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Reschedule Modal -->
<div class="modal fade" id="rescheduleModal" tabindex="-1" aria-labelledby="rescheduleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="rescheduleModalLabel">
                    <i class="fas fa-calendar-alt text-primary me-2"></i>
                    Reschedule Appointment
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>
                    Select a new date and time for this appointment
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="newAppointmentDate" class="form-label">New Date</label>
                            <input type="date" class="form-control" id="newAppointmentDate"
                                   min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="newAppointmentTime" class="form-label">New Time</label>
                            <input type="time" class="form-control" id="newAppointmentTime" />
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="mb-3">
                            <label for="rescheduleReason" class="form-label">Reason for rescheduling</label>
                            <textarea class="form-control" id="rescheduleReason" rows="2"
                                      placeholder="Optional reason for rescheduling..."></textarea>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" onclick="rescheduleAppointment()">
                    <i class="fas fa-calendar-check me-1"></i>Reschedule
                </button>
            </div>
        </div>
    </div>
</div>

@functions {
    private string GetStatusBadgeClass(string status)
    {
        return status?.ToLower() switch
        {
            "scheduled" => "bg-primary",
            "confirmed" => "bg-info",
            "in progress" => "bg-warning",
            "completed" => "bg-success",
            "cancelled" => "bg-danger",
            "no show" => "bg-dark",
            "rescheduled" => "bg-purple",
            _ => "bg-secondary"
        };
    }

    private string GetDuration(DateTime startTime, DateTime endTime)
    {
        var duration = endTime - startTime;
        if (duration.TotalHours < 1)
        {
            return $"{duration.TotalMinutes} min";
        }
        else if (duration.TotalHours < 24)
        {
            return $"{duration.TotalHours:0.##} hours";
        }
        return $"{duration.TotalDays:0.##} days";
    }
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Set min date for rescheduling
            const today = new Date().toISOString().split('T')[0];
            const newDateInput = document.getElementById('newAppointmentDate');
            if (newDateInput) {
                newDateInput.min = today;
            }
        });

        function cancelAppointment() {
            const cancellationReason = document.getElementById('cancellationReason').value;

            if (!cancellationReason.trim()) {
                alert('Please provide a reason for cancellation.');
                return;
            }

            // Here you would typically make an API call to update the appointment status
            // For now, we'll redirect to edit page with a query parameter
            window.location.href = `@Url.Page("./Edit", new { id = Model.Appointment.AppointmentId })?cancel=true&reason=${encodeURIComponent(cancellationReason)}`;
        }

        function rescheduleAppointment() {
            const newDate = document.getElementById('newAppointmentDate').value;
            const newTime = document.getElementById('newAppointmentTime').value;
            const reason = document.getElementById('rescheduleReason').value;

            if (!newDate || !newTime) {
                alert('Please select both a new date and time.');
                return;
            }

            // Here you would typically make an API call to reschedule the appointment
            // For now, we'll redirect to edit page with query parameters
            const newDateTime = `${newDate}T${newTime}`;
            window.location.href = `@Url.Page("./Edit", new { id = Model.Appointment.AppointmentId })?reschedule=true&newDateTime=${encodeURIComponent(newDateTime)}&reason=${encodeURIComponent(reason)}`;
        }

        // Print functionality
        document.querySelector('.btn-outline-info')?.addEventListener('click', function(e) {
            e.preventDefault();
            window.print();
        });

        // Send reminder functionality
        document.querySelector('.btn-outline-success')?.addEventListener('click', function(e) {
            e.preventDefault();
            if (confirm('Send reminder to patient about this appointment?')) {
                // Here you would make an API call to send reminder
                alert('Reminder sent successfully!');
            }
        });
    </script>
}