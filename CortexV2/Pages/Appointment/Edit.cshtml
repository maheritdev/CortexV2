@page
@model Cortex.Pages.Appointment.EditModel

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Pages/Shared/_DashboardLayout.cshtml";
}

<h1>Edit</h1>

<h4>Appointment</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Appointment.AppointmentId" />
            <div class="form-group">
                <label asp-for="Appointment.PatientId" class="control-label"></label>
                <select asp-for="Appointment.PatientId" class="form-control" asp-items="ViewBag.PatientId"></select>
                <span asp-validation-for="Appointment.PatientId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Appointment.DoctorId" class="control-label"></label>
                <select asp-for="Appointment.DoctorId" class="form-control" asp-items="ViewBag.DoctorId"></select>
                <span asp-validation-for="Appointment.DoctorId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Appointment.AppointmentDate" class="control-label"></label>
                <input asp-for="Appointment.AppointmentDate" class="form-control" />
                <span asp-validation-for="Appointment.AppointmentDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Appointment.Reason" class="control-label"></label>
                <input asp-for="Appointment.Reason" class="form-control" />
                <span asp-validation-for="Appointment.Reason" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Appointment.Status" class="control-label"></label>
                <input asp-for="Appointment.Status" class="form-control" />
                <span asp-validation-for="Appointment.Status" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Appointment.Notes" class="control-label"></label>
                <input asp-for="Appointment.Notes" class="form-control" />
                <span asp-validation-for="Appointment.Notes" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Appointment.CreatedDate" class="control-label"></label>
                <input asp-for="Appointment.CreatedDate" class="form-control" />
                <span asp-validation-for="Appointment.CreatedDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Appointment.CreatedBy" class="control-label"></label>
                <select asp-for="Appointment.CreatedBy" class="form-control" asp-items="ViewBag.CreatedBy"></select>
                <span asp-validation-for="Appointment.CreatedBy" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Appointment.StartTime" class="control-label"></label>
                <input asp-for="Appointment.StartTime" class="form-control" />
                <span asp-validation-for="Appointment.StartTime" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Appointment.EndTime" class="control-label"></label>
                <input asp-for="Appointment.EndTime" class="form-control" />
                <span asp-validation-for="Appointment.EndTime" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>