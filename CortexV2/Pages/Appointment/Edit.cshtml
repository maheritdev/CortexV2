@page
@model Cortex.Pages.Appointment.EditModel

@{
    ViewData["Title"] = "Edit Appointment";
    Layout = "~/Pages/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-page="/Index">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-page="Index">Appointments</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Edit Appointment</li>
                </ol>
            </nav>
            <h1 class="h2 mb-0">Edit Appointment</h1>
            <p class="text-muted">Update appointment details for @Model.PatientName</p>
        </div>
        <div>
            <a asp-page="Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Back to List
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <form method="post" id="appointmentForm">
                <input type="hidden" asp-for="Appointment.AppointmentId" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="row g-4">
                    <!-- Appointment ID & Status -->
                    <div class="col-12">
                        <div class="card border">
                            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                                <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>Appointment Information</h5>
                                <div>
                                    <span class="badge bg-secondary">ID: @Model.Appointment.AppointmentId</span>
                                    <span class="badge bg-info ms-2">Original Doctor: @Model.DoctorName</span>
                                </div>
                            </div>
                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="Appointment.Status" class="form-label fw-semibold">
                                                <i class="fas fa-flag me-1"></i>Status
                                            </label>
                                            <select asp-for="Appointment.Status" class="form-select">
                                                <option value="">-- Select Status --</option>
                                                <option value="Scheduled">Scheduled</option>
                                                <option value="Confirmed">Confirmed</option>
                                                <option value="In Progress">In Progress</option>
                                                <option value="Completed">Completed</option>
                                                <option value="Cancelled">Cancelled</option>
                                                <option value="No Show">No Show</option>
                                                <option value="Rescheduled">Rescheduled</option>
                                            </select>
                                            <span asp-validation-for="Appointment.Status" class="text-danger small"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="form-label fw-semibold">
                                                <i class="fas fa-calendar-plus me-1"></i>Created Date
                                            </label>
                                            <input type="text" class="form-control bg-light"
                                                   value="@Model.Appointment.CreatedDate?.ToString("MMMM dd, yyyy HH:mm")" readonly />
                                            <small class="text-muted">Original creation date</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Patient Information -->
                    <div class="col-lg-6">
                        <div class="card h-100 border">
                            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                                <h5 class="mb-0"><i class="fas fa-user-injured me-2"></i>Patient Information</h5>
                                <span class="badge bg-success">Current: @Model.PatientName</span>
                            </div>
                            <div class="card-body">
                                <div class="mb-3">
                                    <label asp-for="Appointment.PatientId" class="form-label fw-semibold">
                                        <i class="fas fa-user me-1"></i>Select Patient
                                    </label>
                                    <select asp-for="Appointment.PatientId" class="form-select form-select-lg" asp-items="ViewBag.PatientId">
                                        <option value="">-- Select Patient --</option>
                                    </select>
                                    <span asp-validation-for="Appointment.PatientId" class="text-danger small"></span>
                                    <small class="text-muted">Current patient: @Model.PatientName</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Doctor Information -->
                    <div class="col-lg-6">
                        <div class="card h-100 border">
                            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                                <h5 class="mb-0"><i class="fas fa-user-md me-2"></i>Doctor Information</h5>
                                <span class="badge bg-info">Current: @Model.DoctorName</span>
                            </div>
                            <div class="card-body">
                                <div class="mb-3">
                                    <label asp-for="Appointment.DoctorId" class="form-label fw-semibold">
                                        <i class="fas fa-stethoscope me-1"></i>Select Doctor
                                    </label>
                                    <select asp-for="Appointment.DoctorId" class="form-select form-select-lg" asp-items="ViewBag.DoctorId">
                                        <option value="">-- Select Doctor --</option>
                                    </select>
                                    <span asp-validation-for="Appointment.DoctorId" class="text-danger small"></span>
                                    <small class="text-muted">Current doctor: @Model.DoctorName</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Date and Time -->
                    <div class="col-12">
                        <div class="card border">
                            <div class="card-header bg-light">
                                <h5 class="mb-0"><i class="fas fa-calendar-alt me-2"></i>Appointment Schedule</h5>
                            </div>
                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label asp-for="Appointment.AppointmentDate" class="form-label fw-semibold">
                                                <i class="fas fa-calendar-day me-1"></i>Appointment Date
                                            </label>
                                            <input asp-for="Appointment.AppointmentDate" type="date"
                                                   class="form-control form-control-lg" />
                                            <span asp-validation-for="Appointment.AppointmentDate" class="text-danger small"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label asp-for="Appointment.StartTime" class="form-label fw-semibold">
                                                <i class="fas fa-clock me-1"></i>Start Time
                                            </label>
                                            <input asp-for="Appointment.StartTime" type="time"
                                                   class="form-control form-control-lg" />
                                            <span asp-validation-for="Appointment.StartTime" class="text-danger small"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label asp-for="Appointment.EndTime" class="form-label fw-semibold">
                                                <i class="fas fa-clock me-1"></i>End Time
                                            </label>
                                            <input asp-for="Appointment.EndTime" type="time"
                                                   class="form-control form-control-lg" />
                                            <span asp-validation-for="Appointment.EndTime" class="text-danger small"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Appointment Details -->
                    <div class="col-12">
                        <div class="card border">
                            <div class="card-header bg-light">
                                <h5 class="mb-0"><i class="fas fa-file-medical me-2"></i>Appointment Details</h5>
                            </div>
                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="Appointment.Reason" class="form-label fw-semibold">
                                                <i class="fas fa-comment-medical me-1"></i>Reason for Visit
                                            </label>
                                            <input asp-for="Appointment.Reason" class="form-control"
                                                   placeholder="Enter the reason for appointment" />
                                            <span asp-validation-for="Appointment.Reason" class="text-danger small"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="form-label fw-semibold">
                                                <i class="fas fa-user-edit me-1"></i>Created By
                                            </label>
                                            <input type="hidden" asp-for="Appointment.CreatedBy" />
                                            <div class="card bg-light border">
                                                <div class="card-body py-2">
                                                    <div class="d-flex align-items-center">
                                                        <div class="flex-shrink-0">
                                                            <div class="avatar avatar-sm rounded-circle bg-primary text-white d-flex align-items-center justify-content-center">
                                                                <i class="fas fa-user"></i>
                                                            </div>
                                                        </div>
                                                        <div class="flex-grow-1 ms-3">
                                                            <h6 class="mb-0">@Model.CreatedByName</h6>
                                                            <small hidden class="text-muted">Staff : @Model.CreatedByName</small>
                                                        </div>
                                                        <div class="flex-shrink-0">
                                                            <span class="badge bg-secondary">Original Creator</span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <small class="form-text text-muted mt-2">
                                                <i class="fas fa-info-circle me-1"></i>
                                                Original appointment creator (cannot be changed)
                                            </small>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="mb-3">
                                            <label asp-for="Appointment.Notes" class="form-label fw-semibold">
                                                <i class="fas fa-notes-medical me-1"></i>Additional Notes
                                            </label>
                                            <textarea asp-for="Appointment.Notes" class="form-control"
                                                      rows="4" placeholder="Enter any additional notes or observations..."></textarea>
                                            <span asp-validation-for="Appointment.Notes" class="text-danger small"></span>
                                            <small class="text-muted">Add any updates or changes made to this appointment</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Form Actions -->
                <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                    <div>
                        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#cancelModal">
                            <i class="fas fa-times me-2"></i>Cancel Appointment
                        </button>
                    </div>
                    <div class="d-flex gap-2">
                        <a asp-page="Index" class="btn btn-lg btn-outline-secondary px-4">
                            <i class="fas fa-times me-2"></i>Discard Changes
                        </a>
                        <button type="submit" class="btn btn-lg btn-primary px-4" id="submitBtn">
                            <i class="fas fa-save me-2"></i>Update Appointment
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Cancel Appointment Modal -->
<div class="modal fade" id="cancelModal" tabindex="-1" aria-labelledby="cancelModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="cancelModalLabel">
                    <i class="fas fa-exclamation-triangle text-warning me-2"></i>
                    Cancel Appointment
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <strong>Warning:</strong> Are you sure you want to cancel this appointment?
                </div>
                <p>This action will change the appointment status to "Cancelled". The following will happen:</p>
                <ul>
                    <li>Appointment status will be set to "Cancelled"</li>
                    <li>Original creator information will be preserved</li>
                    <li>Cancellation note will be added to the appointment notes</li>
                </ul>
                <div class="form-check mt-3">
                    <input class="form-check-input" type="checkbox" id="sendNotification" checked>
                    <label class="form-check-label" for="sendNotification">
                        Send cancellation notification to patient
                    </label>
                </div>
                <div class="form-group mt-3">
                    <label for="cancellationReason" class="form-label">Reason for cancellation</label>
                    <textarea class="form-control" id="cancellationReason" rows="3"
                              placeholder="Enter reason for cancellation (this will be added to notes)..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-danger" onclick="cancelAppointment()">
                    <i class="fas fa-ban me-1"></i>Cancel Appointment
                </button>
            </div>
        </div>
    </div>
</div>
