@page "{id:int}"
@model Cortex.UI.Areas.Web.Pages.Patients.EditModel
@{
    Layout = "~/Pages/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Edit Patient";
}

<div class="min-vh-100 bg-light py-4">
    <div class="container-fluid">
        <!-- Header Section -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center">
                        @* @{
                            var backUrl = Url.Page("../Index", new { area = "Web" });
                        }
                        <a href="@backUrl" class="btn btn-outline-secondary btn-sm me-3">
                            <i class="fas fa-arrow-left me-2"></i>Back
                        </a> *@
                        <div>
                            <h1 class="h2 mb-1 text-dark">Edit Patient</h1>
                            <p class="text-muted mb-0">Update patient information and medical details</p>
                        </div>
                    </div>
                    <div>
                        <span class="badge bg-primary bg-opacity-10 text-white fs-6">
                            <i class="fas fa-user-edit me-1 text-white"></i>Editing Mode
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-8">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-primary bg-opacity-10 border-0 py-3">
                        <h3 class="h5 mb-0 text-dark">
                            <i class="fas fa-user-edit me-2 text-primary"></i>
                            Patient Information
                        </h3>
                    </div>
                    <div class="card-body p-4">
                        <form method="post" id="editForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="@Model.Input.PatientID" />

                            <!-- Personal Information -->
                            <div class="row mb-4">
                                <div class="col-12">
                                    <h5 class="text-primary mb-3">
                                        <i class="fas fa-user me-2"></i>Personal Information
                                    </h5>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Input.FirstName" class="form-label fw-medium">First Name *</label>
                                    <input asp-for="Input.FirstName" class="form-control" placeholder="Enter first name" value="@Model.Input.FirstName" />
                                    <span asp-validation-for="Input.FirstName" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Input.LastName" class="form-label fw-medium">Last Name *</label>
                                    <input asp-for="Input.LastName" class="form-control" placeholder="Enter last name" value="@Model.Input.LastName"  />
                                    <span asp-validation-for="Input.LastName" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Input.Gender" class="form-label fw-medium">Gender</label>
                                    <select asp-for="Input.Gender" class="form-select">
                                        <option value="">Select Gender</option>
                                        <option value="Male" selected="@(Model.Input?.Gender == "Male")">Male</option>
                                        <option value="Female" selected="@(Model.Input?.Gender == "Female")">Female</option>
                                    </select>
                                    <span asp-validation-for="Input.Gender" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Input.DateOfBirth" class="form-label fw-medium">Date of Birth</label>
                                    <input asp-for="Input.DateOfBirth"
                                           type="date"
                                           class="form-control"
                                           value="@Model.Input.DateOfBirth" />
                                    <span asp-validation-for="Input.DateOfBirth" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Input.BloodType" class="form-label fw-medium">Blood Type</label>
                                    <select asp-for="Input.BloodType" class="form-select">
                                        <option value="">Select Blood Type</option>
                                        <option value="A+" selected="@(Model.Input?.BloodType == "A+")">A+</option>
                                        <option value="A-" selected="@(Model.Input?.BloodType == "A-")">A-</option>
                                        <option value="B+" selected="@(Model.Input?.BloodType == "B+")">B+</option>
                                        <option value="B-" selected="@(Model.Input?.BloodType == "B-")">B-</option>
                                        <option value="AB+" selected="@(Model.Input?.BloodType == "AB+")">AB+</option>
                                        <option value="AB-" selected="@(Model.Input?.BloodType == "AB-")">AB-</option>
                                        <option value="O+" selected="@(Model.Input?.BloodType == "O+")">O+</option>
                                        <option value="O-" selected="@(Model.Input?.BloodType == "O-")">O-</option>
                                    </select>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Input.Status" class="form-label fw-medium">Status</label>
                                    <select asp-for="Input.Status" class="form-select">
                                        <option value="">Select Blood Type</option>
                                        <option value="A+" selected="@(Model.Input?.BloodType == "A+")">A+</option>
                                        <option value="Active" selected="@(Model.Input?.Status == "Active")">Active</option>
                                        <option value="Inactive" selected="@(Model.Input?.Status == "Inactive")">Inactive</option>
                                        <option value="Transferred" selected="@(Model.Input?.Status == "Transferred")">Transferred</option>
                                        <option value="Deceased" selected="@(Model.Input?.Status == "Deceased")">Deceased</option>
                                    </select>
                                </div>
                            </div>

                            <!-- Contact Information -->
                            <div class="row mb-4">
                                <div class="col-12">
                                    <h5 class="text-primary mb-3">
                                        <i class="fas fa-address-card me-2"></i>Contact Information
                                    </h5>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Input.Email" class="form-label fw-medium">Email Address</label>
                                    <input asp-for="Input.Email" type="email" class="form-control" placeholder="patient@example.com" value="@Model.Input.Email" />
                                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Input.ContactNumber" class="form-label fw-medium">Phone Number *</label>
                                    <input asp-for="Input.ContactNumber" class="form-control" placeholder="+1 (555) 123-4567" value="@Model.Input.ContactNumber" />
                                    <span asp-validation-for="Input.ContactNumber" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Input.AlternateContact" class="form-label fw-medium">Alternate Phone</label>
                                    <input asp-for="Input.AlternateContact" class="form-control" placeholder="+1 (555) 123-4567" value="@Model.Input.AlternateContact"/>
                                </div>
                            </div>

                            <!-- Address Information -->
                            <div class="row mb-4">
                                <div class="col-12">
                                    <h5 class="text-primary mb-3">
                                        <i class="fas fa-map-marker-alt me-2"></i>Address Information
                                    </h5>
                                </div>
                                <div class="col-12 mb-3">
                                    <label asp-for="Input.Address" class="form-label fw-medium">Street Address *</label>
                                    <input asp-for="Input.Address" class="form-control" placeholder="123 Main Street" value="@Model.Input.Address"  />
                                    <span asp-validation-for="Input.Address" class="text-danger small"></span>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label asp-for="Input.City" class="form-label fw-medium">City</label>
                                    <input asp-for="Input.City" class="form-control" placeholder="City" value="@Model.Input.City"/>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label asp-for="Input.State" class="form-label fw-medium">State/Province</label>
                                    <input asp-for="Input.State" class="form-control" placeholder="State" value="@Model.Input.State"  />
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label asp-for="Input.ZipCode" class="form-label fw-medium">ZIP/Postal Code</label>
                                    <input asp-for="Input.ZipCode" class="form-control" placeholder="12345" value="@Model.Input.ZipCode"  />
                                </div>
                                <div class="col-12 mb-3">
                                    <label asp-for="Input.Country" class="form-label fw-medium">Country</label>
                                    <input asp-for="Input.Country" class="form-control" placeholder="Country" value="@Model.Input.Country"  />
                                </div>
                            </div>

                            <!-- Emergency Contact -->
                            <div class="row mb-4">
                                <div class="col-12">
                                    <h5 class="text-primary mb-3">
                                        <i class="fas fa-exclamation-triangle me-2"></i>Emergency Contact
                                    </h5>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Input.EmergencyContactName" class="form-label fw-medium">Emergency Contact Name</label>
                                    <input asp-for="Input.EmergencyContactName" class="form-control" placeholder="Full name" value="@Model.Input.EmergencyContactName"  />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Input.EmergencyContactNumber" class="form-label fw-medium">Emergency Contact Phone</label>
                                    <input asp-for="Input.EmergencyContactNumber" class="form-control" placeholder="+1 (555) 123-4567" value="@Model.Input.EmergencyContactNumber"  />
                                </div>
                            </div>

                            <!-- Insurance Information -->
                            <div class="row mb-4">
                                <div class="col-12">
                                    <h5 class="text-primary mb-3">
                                        <i class="fas fa-shield-alt me-2"></i>Insurance Information
                                    </h5>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Input.InsuranceProvider" class="form-label fw-medium">Insurance Provider</label>
                                    <input asp-for="Input.InsuranceProvider" class="form-control" placeholder="Insurance company name" value="@Model.Input.InsuranceProvider"  />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Input.InsurancePolicyNumber" class="form-label fw-medium">Policy Number</label>
                                    <input asp-for="Input.InsurancePolicyNumber" class="form-control" placeholder="Policy number" value="@Model.Input.InsurancePolicyNumber"  />
                                </div>
                            </div>

                            <!-- Medical Information -->
                            <div class="row mb-4">
                                <div class="col-12">
                                    <h5 class="text-primary mb-3">
                                        <i class="fas fa-file-medical me-2"></i>Medical Information
                                    </h5>
                                </div>
                                <div class="col-12 mb-3">
                                    <label asp-for="Input.MedicalHistory" class="form-label fw-medium">Medical History</label>
                                    <textarea asp-for="Input.MedicalHistory" class="form-control" rows="4" placeholder="Patient's medical history, past conditions, surgeries, etc." value="@Model.Input.MedicalHistory"></textarea>
                                </div>
                                <div class="col-12 mb-3">
                                    <label asp-for="Input.Allergies" class="form-label fw-medium">Allergies</label>
                                    <textarea asp-for="Input.Allergies" class="form-control" rows="3" placeholder="List any known allergies, medications, foods, etc." value="@Model.Input.Allergies"></textarea>
                                </div>
                            </div>

                            <!-- Form Actions -->
                            <div class="row mt-4">
                                <div class="col-12">
                                    <div class="d-flex gap-2 justify-content-end border-top pt-4">
                                        <a asp-area="Web" class="btn btn-outline-secondary">
                                            <i class="fas fa-times me-2"></i>Cancel
                                        </a>
                                        <button type="submit" class="btn btn-primary">
                                            <i class="fas fa-save me-2"></i>Save Changes
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Sidebar with Patient Summary -->
            <div class="col-lg-4">
                <div class="card shadow-sm border-0 sticky-top" style="top: 100px;">
                    <div class="card-header bg-light border-0 py-3">
                        <h5 class="mb-0 text-dark">
                            <i class="fas fa-info-circle me-2 text-primary"></i>
                            Patient Summary
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="text-center mb-4">
                            <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                                 style="width: 80px; height: 80px; font-size: 2rem; font-weight: 600;">
                                @Model.Input?.FirstName?[0]@Model.Input?.LastName?[0]
                            </div>
                            <h6 class="fw-bold">@Model.Input?.FirstName @Model.Input?.LastName</h6>
                            <p class="text-muted small">Patient ID: #@Model.Input?.PatientID</p>
                        </div>

                        <div class="alert alert-info border-0">
                            <i class="fas fa-lightbulb me-2"></i>
                            <small>All changes will be logged in the patient's medical record.</small>
                        </div>

                        <div class="mt-3">
                            <h6 class="fw-medium mb-2">Quick Tips:</h6>
                            <ul class="small text-muted">
                                <li>Fields marked with * are required</li>
                                <li>Update emergency contact for critical situations</li>
                                <li>Keep insurance information current</li>
                                <li>Document all medical changes accurately</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



<style>
    .card {
        border-radius: 0.75rem;
        transition: transform 0.2s ease-in-out;
    }

    .form-control:focus, .form-select:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.1);
    }

    .form-control.touched:invalid {
        border-color: #dc3545;
    }

    .form-control.touched:valid {
        border-color: #198754;
    }

    .sticky-top {
        position: sticky;
        z-index: 100;
    }

    .btn {
        border-radius: 0.5rem;
        transition: all 0.2s ease-in-out;
    }
</style>