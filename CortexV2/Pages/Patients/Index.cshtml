@page
@model Cortex.UI.Areas.Web.Pages.Patients.IndexModel
@{
    Layout = "~/Pages/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Patients";
}

<div class="bg-white p-4 rounded shadow">
    <div class="flex justify-between items-center mb-4">
        <h2 class="text-xl font-semibold">Patients</h2>
        <a href="./Patients/Create" class="px-3 py-2 btn-outline-primary  rounded"> <i class="fa-solid fa-user-plus"></i> New Patient</a>
    </div>

    @if (TempData["StatusMessage"] != null)
    {
        <div class="mb-3 p-2 bg-green-100 text-green-800 rounded">@TempData["StatusMessage"]</div>
    }

    <table class="table align-middle mb-0 bg-white">
        <thead class="bg-light">
            <tr>
                <th class="p-2 text-left">#</th>
                <th class="p-2 text-left">Name</th>
                <th class="p-2 text-left">Phone</th>
                <th class="p-2 text-left">Email</th>
                <th class="p-2 text-left">Status</th>
                <th class="p-2 text-left">Registered</th>
                <th class="p-2 text-left">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Patients?.Count == 0)
            {
                <tr><td colspan="6" class="p-4 text-center text-sm text-slate-500">No patients found</td></tr>
            }
            else
            {
                foreach (var p in Model.Patients)
                {
                    <tr class="border-t">
                        <td class="p-2">@p.PatientID</td>
                        <td class="p-2">@p.FirstName @p.LastName</td>
                        <td class="p-2">@p.ContactNumber</td>
                        <td class="p-2">@p.Email</td>
                        
                        <td class="p-2 ">@p.Status</td>
                        <td class="p-2  @p.Status == 'Active' ? "text-success" : "text-primary";"
     >@p.RegistrationDate?.ToString("yyyy-MM-dd")</td>
                        <td>
                            <!-- This is fine if you prefer traditional HTML -->
                            <a href="/Patients/Details/@p.PatientID" class="btn btn-sm btn-outline-primary me-2">
                                <i class="fas fa-eye"></i> View
                            </a>

                            <a href="/Patients/Edit/@p.PatientID" class="btn btn-sm btn-outline-secondary me-2">
                                <i class="fas fa-edit"></i> Edit
                            </a>

                            <button class="btn btn-sm btn-outline-danger" onclick="deletePatient(@p.PatientID)">
                                <i class="fas fa-trash"></i> Delete
                            </button>

                            @* <a href="/Patients/Details/@p.PatientID" class="btn btn-sm btn-outline-primary me-2"><i class="fas fa-eye"></i> View</a>

                            <a href="/Patients/Edit/@p.PatientID" class="btn btn-sm btn-outline-secondary me-2">
                                <i class="fas fa-edit"></i> Edit
                            </a>

                            <button class="btn btn-sm btn-outline-danger"
                                    onclick="deletePatient(@p.PatientID)">
                                <i class="fas fa-trash"></i> Delete
                            </button> *@
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
