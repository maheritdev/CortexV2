    <script>
        // Form validation and submission handling
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('appointmentForm');
            const submitBtn = document.getElementById('submitBtn');

            // Date validation
            const appointmentDate = document.querySelector('input[asp-for="Appointment.AppointmentDate"]');
            if (appointmentDate) {
                const today = new Date().toISOString().split('T')[0];
                appointmentDate.min = today;
            }

            // Time validation
            const startTime = document.querySelector('input[asp-for="Appointment.StartTime"]');
            const endTime = document.querySelector('input[asp-for="Appointment.EndTime"]');

            if (startTime && endTime) {
                startTime.addEventListener('change', function() {
                    if (endTime.value && this.value > endTime.value) {
                        alert('Start time cannot be later than end time');
                        this.value = '';
                    }
                });

                endTime.addEventListener('change', function() {
                    if (startTime.value && this.value < startTime.value) {
                        alert('End time cannot be earlier than start time');
                        this.value = '';
                    }
                });
            }

            // Form submission handling
            form.addEventListener('submit', function(e) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Scheduling...';

                // You can add additional validation here
                const patientId = document.querySelector('select[asp-for="Appointment.PatientId"]').value;
                const doctorId = document.querySelector('select[asp-for="Appointment.DoctorId"]').value;

                if (!patientId || !doctorId) {
                    e.preventDefault();
                    alert('Please select both patient and doctor');
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i class="fas fa-calendar-plus me-2"></i>Create Appointment';
                }
            });
        });
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('appointmentForm');
            const submitBtn = document.getElementById('submitBtn');

            // Format date and time inputs
            formatDateTimeInputs();

            // Set up time validation
            setupTimeValidation();

            // Form submission handling
            form.addEventListener('submit', function(e) {
                if (!validateForm()) {
                    e.preventDefault();
                    return;
                }

                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Saving Changes...';
            });
        });

        function formatDateTimeInputs() {
            // Format date input
            const dateInput = document.querySelector('input[asp-for="Appointment.AppointmentDate"]');
            if (dateInput && dateInput.value) {
                try {
                    const date = new Date(dateInput.value);
                    if (!isNaN(date)) {
                        dateInput.value = date.toISOString().split('T')[0];
                    }
                } catch (e) {
                    console.log('Date formatting error:', e);
                }
            }

            // Format time inputs
            const timeInputs = [
                document.querySelector('input[asp-for="Appointment.StartTime"]'),
                document.querySelector('input[asp-for="Appointment.EndTime"]')
            ];

            timeInputs.forEach(input => {
                if (input && input.value) {
                    try {
                        // If it's a DateTime object, extract time part
                        if (input.value.includes(' ')) {
                            const timePart = input.value.split(' ')[1];
                            if (timePart) {
                                input.value = timePart.substring(0, 5);
                            }
                        } else if (input.value.includes('T')) {
                            // Handle ISO string
                            const date = new Date(input.value);
                            const hours = date.getHours().toString().padStart(2, '0');
                            const minutes = date.getMinutes().toString().padStart(2, '0');
                            input.value = `${hours}:${minutes}`;
                        }
                    } catch (e) {
                        console.log('Time formatting error:', e);
                    }
                }
            });
        }

        function setupTimeValidation() {
            const startTime = document.querySelector('input[asp-for="Appointment.StartTime"]');
            const endTime = document.querySelector('input[asp-for="Appointment.EndTime"]');

            if (startTime && endTime) {
                startTime.addEventListener('change', function() {
                    if (endTime.value && this.value > endTime.value) {
                        showAlert('Start time cannot be later than end time', 'warning');
                        this.value = '';
                    }
                });

                endTime.addEventListener('change', function() {
                    if (startTime.value && this.value < startTime.value) {
                        showAlert('End time cannot be earlier than start time', 'warning');
                        this.value = '';
                    }
                });
            }
        }

        function validateForm() {
            const patientId = document.querySelector('select[asp-for="Appointment.PatientId"]').value;
            const doctorId = document.querySelector('select[asp-for="Appointment.DoctorId"]').value;
            const status = document.querySelector('select[asp-for="Appointment.Status"]').value;

            if (!patientId || !doctorId || !status) {
                showAlert('Please fill all required fields: Patient, Doctor, and Status', 'error');
                return false;
            }

            return true;
        }

        function cancelAppointment() {
            const cancellationReason = document.getElementById('cancellationReason').value;
            const sendNotification = document.getElementById('sendNotification').checked;

            // Update status to cancelled
            const statusSelect = document.querySelector('select[asp-for="Appointment.Status"]');
            statusSelect.value = 'Cancelled';

            // Add cancellation note to notes
            const notesTextarea = document.querySelector('textarea[asp-for="Appointment.Notes"]');
            const currentDate = new Date().toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
                hour: '2-digit',
                minute: '2-digit'
            });

            let cancellationNote = $"\n\n--- CANCELLATION ---\n";
            cancellationNote += $"Date: {currentDate}\n";
            cancellationNote += $"Reason: {cancellationReason || 'No reason provided'}\n";
            cancellationNote += $"Notification Sent: {(sendNotification ? 'Yes' : 'No')}\n";
            cancellationNote += $"Cancelled by: [Current User]\n";
            cancellationNote += "-------------------";

            notesTextarea.value += cancellationNote;

            // Submit the form
            document.getElementById('appointmentForm').submit();

            // Close modal
            const modal = bootstrap.Modal.getInstance(document.getElementById('cancelModal'));
            if (modal) modal.hide();
        }

        function showAlert(message, type = 'info') {
            const alertClass = type === 'error' ? 'alert-danger' :
                               type === 'warning' ? 'alert-warning' : 'alert-info';

            // Create alert element
            const alertDiv = document.createElement('div');
            alertDiv.className = `alert ${alertClass} alert-dismissible fade show position-fixed`;
            alertDiv.style.cssText = 'top: 20px; right: 20px; z-index: 1050; max-width: 400px;';
            alertDiv.innerHTML = `
                <strong>${type === 'error' ? 'Error!' : type === 'warning' ? 'Warning!' : 'Info!'}</strong> ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;

            // Add to body
            document.body.appendChild(alertDiv);

            // Auto remove after 5 seconds
            setTimeout(() => {
                if (alertDiv.parentNode) {
                    alertDiv.remove();
                }
            }, 5000);
        }
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('billingForm');
            const submitBtn = document.getElementById('submitBtn');

            // Set current date as default for bill date
            const billDateInput = document.querySelector('input[asp-for="Billing.BillDate"]');
            if (billDateInput && !billDateInput.value) {
                billDateInput.value = new Date().toISOString().split('T')[0];
            }

            // Set minimum due date to today
            const dueDateInput = document.querySelector('input[asp-for="Billing.DueDate"]');
            if (dueDateInput) {
                const today = new Date().toISOString().split('T')[0];
                dueDateInput.min = today;
            }

            // Calculate balance automatically
            const totalAmountInput = document.getElementById('totalAmount');
            const paidAmountInput = document.getElementById('paidAmount');
            const balanceInput = document.getElementById('balanceAmount');

            // Update preview
            updatePreview();

            // Listen to input changes
            totalAmountInput?.addEventListener('input', updateBalanceAndPreview);
            paidAmountInput?.addEventListener('input', updateBalanceAndPreview);
            dueDateInput?.addEventListener('change', updatePreview);

            // Payment status change
            const paidRadios = document.querySelectorAll('input[name="Billing.isPaid"]');
            paidRadios.forEach(radio => {
                radio.addEventListener('change', function() {
                    updatePreview();
                    togglePaidDateSection();
                });
            });

            // Toggle paid date section based on payment status
            function togglePaidDateSection() {
                const paidDateSection = document.getElementById('paidDateSection');
                const isPaidTrue = document.getElementById('isPaidTrue').checked;

                if (isPaidTrue) {
                    paidDateSection.style.display = 'block';
                    // Set default paid date to today
                    const paidDateInput = document.querySelector('input[asp-for="Billing.PaidDate"]');
                    if (paidDateInput && !paidDateInput.value) {
                        paidDateInput.value = new Date().toISOString().split('T')[0];
                    }
                } else {
                    paidDateSection.style.display = 'none';
                }
            }

            // Calculate balance
            function updateBalanceAndPreview() {
                const totalAmount = parseFloat(totalAmountInput.value) || 0;
                const paidAmount = parseFloat(paidAmountInput.value) || 0;
                const balance = totalAmount - paidAmount;

                // Update balance field
                if (balanceInput) {
                    balanceInput.value = balance.toFixed(2);

                    // Color coding for balance
                    if (balance === 0) {
                        balanceInput.classList.remove('bg-warning', 'bg-danger');
                        balanceInput.classList.add('bg-success', 'text-white');
                    } else if (balance < 0) {
                        balanceInput.classList.remove('bg-warning', 'bg-success');
                        balanceInput.classList.add('bg-danger', 'text-white');
                    } else {
                        balanceInput.classList.remove('bg-success', 'bg-danger');
                        balanceInput.classList.add('bg-warning');
                    }
                }

                updatePreview();
            }

            // Update preview panel
            function updatePreview() {
                // Bill date
                const billDate = billDateInput?.value;
                if (billDate) {
                    const date = new Date(billDate);
                    document.getElementById('previewBillDate').textContent =
                        date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
                }

                // Due date
                const dueDate = dueDateInput?.value;
                if (dueDate) {
                    const date = new Date(dueDate);
                    document.getElementById('previewDueDate').textContent =
                        date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
                } else {
                    document.getElementById('previewDueDate').textContent = '--';
                }

                // Amounts
                const totalAmount = parseFloat(totalAmountInput?.value) || 0;
                const paidAmount = parseFloat(paidAmountInput?.value) || 0;
                const balance = totalAmount - paidAmount;

                document.getElementById('previewTotalAmount').textContent = `$${totalAmount.toFixed(2)}`;
                document.getElementById('previewPaidAmount').textContent = `$${paidAmount.toFixed(2)}`;
                document.getElementById('previewBalance').textContent = `$${balance.toFixed(2)}`;

                // Status
                const isPaid = document.getElementById('isPaidTrue').checked;
                const statusBadge = document.getElementById('previewStatus');

                if (isPaid) {
                    statusBadge.textContent = 'Paid';
                    statusBadge.className = 'badge bg-success';
                } else if (balance === 0 && totalAmount > 0) {
                    statusBadge.textContent = 'Paid';
                    statusBadge.className = 'badge bg-success';
                } else if (paidAmount > 0) {
                    statusBadge.textContent = 'Partial';
                    statusBadge.className = 'badge bg-info';
                } else if (balance > 0) {
                    statusBadge.textContent = 'Pending';
                    statusBadge.className = 'badge bg-warning';
                } else {
                    statusBadge.textContent = 'Pending';
                    statusBadge.className = 'badge bg-warning';
                }
            }

            // Form validation
            form.addEventListener('submit', function(e) {
                // Validate required fields
                const patientId = document.querySelector('select[asp-for="Billing.PatientId"]').value;
                const totalAmount = parseFloat(totalAmountInput?.value) || 0;

                if (!patientId) {
                    e.preventDefault();
                    showAlert('Please select a patient', 'error');
                    return;
                }

                if (totalAmount <= 0) {
                    e.preventDefault();
                    showAlert('Total amount must be greater than 0', 'error');
                    return;
                }

                // Validate paid amount
                const paidAmount = parseFloat(paidAmountInput?.value) || 0;
                if (paidAmount > totalAmount) {
                    e.preventDefault();
                    showAlert('Paid amount cannot exceed total amount', 'error');
                    return;
                }

                // Set current user as created by (you need to implement this)
                const createdByField = document.getElementById('createdByField');
                // createdByField.value = getCurrentUserId(); // Implement this function

                // Show loading state
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Creating...';
            });

            // Initialize toggle
            togglePaidDateSection();
            updateBalanceAndPreview();
        });

        function showAlert(message, type = 'info') {
            const alertClass = type === 'error' ? 'alert-danger' :
                               type === 'warning' ? 'alert-warning' : 'alert-info';

            // Remove existing alerts
            const existingAlerts = document.querySelectorAll('.alert-toast');
            existingAlerts.forEach(alert => alert.remove());

            // Create alert element
            const alertDiv = document.createElement('div');
            alertDiv.className = `alert ${alertClass} alert-dismissible fade show alert-toast position-fixed`;
            alertDiv.style.cssText = 'top: 20px; right: 20px; z-index: 1050; max-width: 400px;';
            alertDiv.innerHTML = `
                <strong>${type === 'error' ? 'Error!' : type === 'warning' ? 'Warning!' : 'Info!'}</strong> ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;

            // Add to body
            document.body.appendChild(alertDiv);

            // Auto remove after 5 seconds
            setTimeout(() => {
                if (alertDiv.parentNode) {
                    alertDiv.remove();
                }
            }, 5000);
        }
    </script>


