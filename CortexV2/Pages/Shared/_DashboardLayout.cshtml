                background-color: #dee2e6;
            }

        .timeline-item {
            position: relative;
            margin-bottom: 20px;
        }

            .timeline-item:last-child {
                margin-bottom: 0;
            }

        .timeline-marker {
            position: absolute;
            left: -20px;
