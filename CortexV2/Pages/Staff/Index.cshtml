@page
@model Cortex.Pages.Staff.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_DashboardLayout.cshtml";
}

<h1>Index</h1>

<p>
    <a asp-page="Create" class="px-3 py-2 btn-outline-primary  rounded"> <i class="fa-solid fa-user-plus"></i> Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.Label("Name")
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Staff[0].Gender)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Staff[0].DateOfBirth)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Staff[0].ContactNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Staff[0].Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Staff[0].Address)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Staff[0].Specialization)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Staff[0].Qualification)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Staff[0].HireDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Staff[0].Salary)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Staff[0].Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Staff[0].Department)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Staff) {
        <tr>
            <td>
                    @Html.Label($"{item.FirstName} {item.LastName}")
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Gender)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DateOfBirth)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ContactNumber)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Address)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Specialization)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Qualification)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.HireDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Salary)
            </td>
            <td>
                    @if (item.Status == "Active")
                    {
                        <i class="fa-solid fa-circle text-success"></i>
                    }
                    else
                    {
                        <i class="fa-solid fa-circle-xmark text-danger"></i>
                    }
            
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Department.DepartmentName)
            </td>
            <td>
                <a class="btn btn-sm btn-outline-secondary me-2" asp-page="./Edit" asp-route-id="@item.StaffID"> <i class="fas fa-edit"></i> Edit</a>
                <a class="btn btn-sm btn-outline-primary me-2" asp-page="./Details" asp-route-id="@item.StaffID"> <i class="fas fa-eye"></i> Details</a>
                <a class="btn btn-sm btn-outline-danger" asp-page="./Delete" asp-route-id="@item.StaffID"><i class="fas fa-trash"></i> Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
