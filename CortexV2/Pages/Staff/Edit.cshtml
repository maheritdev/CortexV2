@page
@model Cortex.Pages.Staff.EditModel

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Pages/Shared/_DashboardLayout.cshtml";
}

<h1>Edit</h1>

<h4>Staff</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Staff.StaffID" />
            <div class="form-group">
                <label asp-for="Staff.FirstName" class="control-label"></label>
                <input asp-for="Staff.FirstName" class="form-control" />
                <span asp-validation-for="Staff.FirstName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Staff.LastName" class="control-label"></label>
                <input asp-for="Staff.LastName" class="form-control" />
                <span asp-validation-for="Staff.LastName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Staff.Gender" class="control-label"></label>
                <input asp-for="Staff.Gender" class="form-control" />
                <span asp-validation-for="Staff.Gender" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Staff.DateOfBirth" class="control-label"></label>
                <input asp-for="Staff.DateOfBirth" class="form-control" />
                <span asp-validation-for="Staff.DateOfBirth" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Staff.ContactNumber" class="control-label"></label>
                <input asp-for="Staff.ContactNumber" class="form-control" />
                <span asp-validation-for="Staff.ContactNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Staff.Email" class="control-label"></label>
                <input asp-for="Staff.Email" class="form-control" />
                <span asp-validation-for="Staff.Email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Staff.Address" class="control-label"></label>
                <input asp-for="Staff.Address" class="form-control" />
                <span asp-validation-for="Staff.Address" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Staff.DepartmentId" class="control-label"></label>
                <select asp-for="Staff.DepartmentId" class="form-control" asp-items="ViewBag.DepartmentId"></select>
                <span asp-validation-for="Staff.DepartmentId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Staff.Position" class="control-label"></label>
                <input asp-for="Staff.Position" class="form-control" />
                <span asp-validation-for="Staff.Position" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Staff.Specialization" class="control-label"></label>
                <input asp-for="Staff.Specialization" class="form-control" />
                <span asp-validation-for="Staff.Specialization" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Staff.Qualification" class="control-label"></label>
                <input asp-for="Staff.Qualification" class="form-control" />
                <span asp-validation-for="Staff.Qualification" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Staff.HireDate" class="control-label"></label>
                <input asp-for="Staff.HireDate" class="form-control" />
                <span asp-validation-for="Staff.HireDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Staff.Salary" class="control-label"></label>
                <input asp-for="Staff.Salary" class="form-control" />
                <span asp-validation-for="Staff.Salary" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Staff.Status" class="control-label"></label>
                <input asp-for="Staff.Status" class="form-control" />
                <span asp-validation-for="Staff.Status" class="text-danger"></span>
