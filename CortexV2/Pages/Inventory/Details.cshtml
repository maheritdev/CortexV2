@page
@model Cortex.Pages.Inventory.DetailsModel

@{
    ViewData["Title"] = "Inventory Details";
    Layout = "~/Pages/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid py-4">
    <!-- Header with title and action buttons -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0">Inventory Details</h1>
            <p class="text-muted mb-0">View detailed information about inventory item</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="./Edit" asp-route-id="@Model.Inventory.InventoryId" class="btn btn-primary">
                <i class="fas fa-edit me-2"></i>Edit Item
            </a>
            <a asp-page="./Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Back to List
            </a>
        </div>
    </div>

    <!-- Main content card -->
    <div class="card shadow-sm">
        <div class="card-header bg-light py-3">
            <div class="d-flex align-items-center">
                <div class="me-3">
                    <div class="icon-shape icon-xl bg-primary bg-gradient text-white rounded-circle d-flex align-items-center justify-content-center">
                        <i class="fas fa-box fa-lg"></i>
                    </div>
                </div>
                <div>
                    <h2 class="h4 mb-0">@Model.Inventory.ItemName</h2>
                    <div class="d-flex align-items-center mt-1">
                        <span class="badge bg-@GetStatusBadgeClass(Model.Inventory.Status) me-2">@Model.Inventory.Status</span>
                        <span class="text-muted">ID: @Model.Inventory.InventoryId</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-body">
            <div class="row">
                <!-- Basic Information Column -->
                <div class="col-md-6">
                    <div class="card mb-4 border">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">Basic Information</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="form-label text-muted small mb-1">Item Name</label>
                                <p class="mb-0 fw-medium">@Model.Inventory.ItemName</p>
                            </div>
                            <div class="mb-3">
                                <label class="form-label text-muted small mb-1">Category</label>
                                <div>
                                    <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25">@Model.Inventory.Category</span>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label text-muted small mb-1">Description</label>
                                <p class="mb-0">@(!string.IsNullOrEmpty(Model.Inventory.Description) ? Model.Inventory.Description : "No description provided")</p>
                            </div>
                            <div class="mb-3">
                                <label class="form-label text-muted small mb-1">Supplier</label>
                                <p class="mb-0">@(!string.IsNullOrEmpty(Model.Inventory.Supplier) ? Model.Inventory.Supplier : "Not specified")</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Stock & Pricing Column -->
                <div class="col-md-6">
                    <div class="card mb-4 border">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">Stock & Pricing</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-6 mb-3">
                                    <label class="form-label text-muted small mb-1">Quantity in Stock</label>
                                    <div class="d-flex align-items-center">
                                        <div class="icon-shape icon-sm bg-primary bg-opacity-10 text-primary rounded-circle me-2 d-flex align-items-center justify-content-center">
                                            <i class="fas fa-cubes fa-xs"></i>
                                        </div>
                                        <span class="h5 mb-0">@Model.Inventory.QuantityInStock</span>
                                        <span class="text-muted ms-2">@Model.Inventory.UnitOfMeasure</span>
                                    </div>
                                </div>
                                <div class="col-6 mb-3">
                                    <label class="form-label text-muted small mb-1">Reorder Level</label>
                                    <div class="d-flex align-items-center">
                                        <div class="icon-shape icon-sm bg-warning bg-opacity-10 text-warning rounded-circle me-2 d-flex align-items-center justify-content-center">
                                            <i class="fas fa-exclamation fa-xs"></i>
                                        </div>
                                        <span class="h5 mb-0">@Model.Inventory.ReorderLevel</span>
                                        <span class="text-muted ms-2">@Model.Inventory.UnitOfMeasure</span>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label text-muted small mb-1">Unit Price</label>
                                <p class="h4 mb-0 text-success">$@(Model.Inventory.UnitPrice?.ToString("F2") ?? "0.00")</p>
                                <small class="text-muted">Per @Model.Inventory.UnitOfMeasure</small>
                            </div>

                            <!-- Stock Level Indicator -->
                            <div class="mb-3">
                                <label class="form-label text-muted small mb-1">Stock Level</label>
                                @{
                                    var stockLevel = GetStockLevelPercentage(Model.Inventory.QuantityInStock, Model.Inventory.ReorderLevel);
                                }
                                <div class="d-flex align-items-center mb-2">
                                    <div class="progress flex-grow-1 me-2" style="height: 8px;">
                                        <div class="progress-bar bg-@GetStockLevelColor(stockLevel)" role="progressbar" style="width: @stockLevel%" aria-valuenow="@stockLevel" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                    <span class="small">@stockLevel%</span>
                                </div>
                                <div class="small text-muted">
                                    @if (Model.Inventory.QuantityInStock <= Model.Inventory.ReorderLevel)
                                    {
                                        <span class="text-danger"><i class="fas fa-exclamation-triangle me-1"></i>Stock is at or below reorder level</span>
                                    }
                                    else if (Model.Inventory.QuantityInStock <= Model.Inventory.ReorderLevel * 1.5)
                                    {
                                        <span class="text-warning"><i class="fas fa-exclamation-circle me-1"></i>Stock is approaching reorder level</span>
                                    }
                                    else
                                    {
                                        <span class="text-success"><i class="fas fa-check-circle me-1"></i>Stock is at healthy level</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Timeline & Dates Column -->
                <div class="col-12">
                    <div class="card border">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">Timeline & Dates</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label class="form-label text-muted small mb-1">Last Restocked</label>
                                    <div class="d-flex align-items-center">
                                        <div class="icon-shape icon-sm bg-success bg-opacity-10 text-success rounded-circle me-2 d-flex align-items-center justify-content-center">
                                            <i class="fas fa-shipping-fast fa-xs"></i>
                                        </div>
                                        <div>
                                            <p class="mb-0 fw-medium">@(Model.Inventory.LastRestockedDate?.ToString("MMMM dd, yyyy") ?? "Never")</p>
                                            @if (Model.Inventory.LastRestockedDate.HasValue)
                                            {
                                                <small class="text-muted">@((DateTime.Now - Model.Inventory.LastRestockedDate.Value).Days) days ago</small>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label text-muted small mb-1">Last Updated</label>
                                    <div class="d-flex align-items-center">
                                        <div class="icon-shape icon-sm bg-info bg-opacity-10 text-info rounded-circle me-2 d-flex align-items-center justify-content-center">
                                            <i class="fas fa-sync fa-xs"></i>
                                        </div>
                                        <div>
                                            <p class="mb-0 fw-medium">@Model.Inventory.LastUpdated.ToString("MMMM dd, yyyy")</p>
                                            <small class="text-muted">@((DateTime.Now - Model.Inventory.LastUpdated).Days) days ago</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label text-muted small mb-1">Status</label>
                                    <div class="d-flex align-items-center">
                                        <div class="icon-shape icon-sm bg-@GetStatusBadgeClass(Model.Inventory.Status) bg-opacity-10 text-@GetStatusBadgeClass(Model.Inventory.Status) rounded-circle me-2 d-flex align-items-center justify-content-center">
                                            <i class="fas fa-@GetStatusIcon(Model.Inventory.Status) fa-xs"></i>
                                        </div>
                                        <div>
                                            <p class="mb-0 fw-medium">@Model.Inventory.Status</p>
                                            <small class="text-muted">Inventory Status</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card Footer with action buttons -->
        <div class="card-footer bg-light d-flex justify-content-between">
            <div>
                <a asp-page="./Index" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-2"></i>Back to Inventory List
                </a>
            </div>
            <div class="d-flex gap-2">
                <a asp-page="./Edit" asp-route-id="@Model.Inventory.InventoryId" class="btn btn-primary">
                    <i class="fas fa-edit me-2"></i>Edit Item
                </a>
                <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
                    <i class="fas fa-trash me-2"></i>Delete
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete <strong>@Model.Inventory.ItemName</strong> from the inventory?</p>
                <div class="alert alert-warning mb-0">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    This action cannot be undone. All associated transaction records will also be removed.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Inventory.InventoryId">
                    <button type="submit" class="btn btn-danger">Delete Item</button>
                </form>
            </div>
        </div>
    </div>
</div>

@functions {
    // Helper function to determine badge class based on status
    public string GetStatusBadgeClass(string status)
    {
        if (string.IsNullOrEmpty(status)) return "secondary";

        return status.ToLower() switch
        {
            "active" => "success",
            "inactive" => "secondary",
            "discontinued" => "danger",
            "out of stock" => "warning",
            "low stock" => "warning",
            "on order" => "info",
            _ => "secondary"
        };
    }

    // Helper function to get status icon
    public string GetStatusIcon(string status)
    {
        if (string.IsNullOrEmpty(status)) return "question-circle";

        return status.ToLower() switch
        {
            "active" => "check-circle",
            "inactive" => "pause-circle",
            "discontinued" => "times-circle",
            "out of stock" => "exclamation-triangle",
            "low stock" => "exclamation-circle",
            "on order" => "shipping-fast",
            _ => "question-circle"
        };
    }

    // Helper function to calculate stock level percentage
    public int GetStockLevelPercentage(int? quantity, int? reorderLevel)
    {
        if (!quantity.HasValue || !reorderLevel.HasValue || reorderLevel == 0) return 0;

        // Calculate percentage based on reorder level (100% = 3x reorder level)
        int maxLevel = reorderLevel.Value * 3;
        int percentage = (int)Math.Round((double)quantity.Value / maxLevel * 100);

        return Math.Min(percentage, 100);
    }

    // Helper function to get stock level color
    public string GetStockLevelColor(int percentage)
    {
        if (percentage <= 25) return "danger";
        if (percentage <= 50) return "warning";
        if (percentage <= 75) return "info";
        return "success";
    }
}