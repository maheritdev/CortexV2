@page
@model Cortex.Pages.Inventory.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_DashboardLayout.cshtml";
}

<h1>Index</h1>

<p>
    <a asp-page="Create" class="px-3 py-2 btn-outline-primary  rounded"> <i class="fa-solid fa-user-plus"></i> Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Inventory[0].ItemName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Inventory[0].Category)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Inventory[0].Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Inventory[0].QuantityInStock)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Inventory[0].UnitOfMeasure)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Inventory[0].ReorderLevel)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Inventory[0].UnitPrice)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Inventory[0].Supplier)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Inventory[0].LastRestockedDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Inventory[0].Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Inventory[0].LastUpdated)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Inventory) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ItemName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Category)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.QuantityInStock)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UnitOfMeasure)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ReorderLevel)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UnitPrice)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Supplier)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LastRestockedDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Status)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LastUpdated)
            </td>
            <td>
                <a class="btn btn-sm btn-outline-secondary me-2" asp-page="./Edit" asp-route-id="@item.InventoryId"> <i class="fas fa-edit"></i> Edit</a>
                <a class="btn btn-sm btn-outline-primary me-2" asp-page="./Details" asp-route-id="@item.InventoryId"> <i class="fas fa-eye"></i> Details</a>
                <a class="btn btn-sm btn-outline-danger" asp-page="./Delete" asp-route-id="@item.InventoryId"><i class="fas fa-trash"></i> Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
