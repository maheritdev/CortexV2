@page
@model Cortex.Pages.Laborder.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_DashboardLayout.cshtml";
}

<h1>Index</h1>

<p>
    <a asp-page="Create" class="px-3 py-2 btn-outline-primary  rounded"> <i class="fa-solid fa-user-plus"></i> Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.LabOrder[0].OrderDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LabOrder[0].Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LabOrder[0].Notes)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LabOrder[0].Doctor)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LabOrder[0].Patient)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.LabOrder) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.OrderDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Status)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Notes)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Doctor.FirstName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Patient.FirstName)
            </td>
            <td>
                <a class="btn btn-sm btn-outline-secondary me-2" asp-page="./Edit" asp-route-id="@item.OrderId"> <i class="fas fa-edit"></i> Edit</a>
                <a class="btn btn-sm btn-outline-primary me-2" asp-page="./Details" asp-route-id="@item.OrderId"> <i class="fas fa-eye"></i> Details</a>
                <a class="btn btn-sm btn-outline-danger" asp-page="./Delete" asp-route-id="@item.OrderId"><i class="fas fa-trash"></i> Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
