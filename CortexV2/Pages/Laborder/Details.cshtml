@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize tooltips
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });

            // Status update functionality
            document.getElementById('updateStatusBtn')?.addEventListener('click', function() {
                const modal = new bootstrap.Modal(document.getElementById('statusModal'));
                modal.show();
            });

            document.getElementById('saveStatusUpdate')?.addEventListener('click', function() {
                const newStatus = document.getElementById('newStatus').value;
                const statusNotes = document.getElementById('statusNotes').value;
                
                // In a real application, you would make an API call here
                // For now, we'll just show a success message
                
                showToast(`Order status updated to "${newStatus}"`, 'success');
                
                const modal = bootstrap.Modal.getInstance(document.getElementById('statusModal'));
                modal.hide();
                
                // Refresh the page to show updated status
                setTimeout(() => {
                    window.location.reload();
                }, 1500);
            });

            // Print functionality
            document.querySelector('[onclick="window.print()"]')?.addEventListener('click', function() {
                const modal = bootstrap.Modal.getInstance(document.getElementById('printModal'));
                modal.hide();
            });

            // Show toast function
            function showToast(message, type = 'info') {
                const toastContainer = document.getElementById('toastContainer') || createToastContainer();
                const toastId = 'toast-' + Date.now();
                
                const toastHtml = `
                    <div id="${toastId}" class="toast align-items-center border-0 ${type === 'success' ? 'bg-success text-white' : type === 'error' ? 'bg-danger text-white' : 'bg-info text-white'}" role="alert" aria-live="assertive" aria-atomic="true">
                        <div class="d-flex">
                            <div class="toast-body">
                                <i class="fas ${type === 'success' ? 'fa-check-circle' : type === 'error' ? 'fa-exclamation-circle' : 'fa-info-circle'} me-2"></i>
                                ${message}
                            </div>
                            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                        </div>
                    </div>
                `;
                
                toastContainer.insertAdjacentHTML('beforeend', toastHtml);
                const toastElement = document.getElementById(toastId);
                const toast = new bootstrap.Toast(toastElement);
                toast.show();
                
                toastElement.addEventListener('hidden.bs.toast', function () {
                    toastElement.remove();
                });
            }

            function createToastContainer() {
                const container = document.createElement('div');
                container.id = 'toastContainer';
                container.className = 'toast-container position-fixed bottom-0 end-0 p-3';
                document.body.appendChild(container);
                return container;
            }
        });
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const statusSelect = document.getElementById('newStatus');
            const statusDesc = document.getElementById('selectedStatusDesc');

            // Status descriptions mapping
            const statusDescriptions = {
                'Pending': 'Order has been created but no samples have been collected yet.',
                'Sample Collected': 'Patient samples have been collected and are ready for testing.',
                'In Progress': 'Lab tests are currently being processed and analyzed.',
                'Completed': 'All tests are complete and results are available.',
                'Cancelled': 'Order has been cancelled and will not be processed.',
                'On Hold': 'Order processing is temporarily paused.',
                'Selected': 'Order has been selected for processing.'  // Added this based on your original code
            };

            // Update description when selection changes
            statusSelect.addEventListener('change', function() {
                const selectedStatus = this.value;
                const description = statusDescriptions[selectedStatus] || 'No description available.';
                statusDesc.textContent = description;

                // Highlight the selected option's group
                highlightSelectedGroup();
            });

            // Function to highlight the selected group
            function highlightSelectedGroup() {
                // Remove previous highlights
                document.querySelectorAll('optgroup').forEach(group => {
                    group.style.backgroundColor = '';
                });

                // Highlight current group
                const selectedOption = statusSelect.options[statusSelect.selectedIndex];
                const parentGroup = selectedOption.parentElement;
                if (parentGroup.tagName === 'OPTGROUP') {
                    parentGroup.style.backgroundColor = 'rgba(13, 110, 253, 0.1)';
                }
            }

            // Initialize with first option description
            if (statusSelect.options.length > 0) {
                const firstStatus = statusSelect.options[1]?.value; // Skip the current status option
                if (firstStatus) {
                    statusDesc.textContent = statusDescriptions[firstStatus] || 'No description available.';
                }
            }

            // Add keyboard navigation improvements
            statusSelect.addEventListener('keydown', function(e) {
                if (e.key === 'Enter') {
                    // Optional: Trigger save action on Enter
                    document.getElementById('saveStatusUpdate')?.click();
                }
            });

            // Auto-focus on status dropdown when modal opens
            const statusModal = document.getElementById('statusModal');
            if (statusModal) {
                statusModal.addEventListener('shown.bs.modal', function () {
                    setTimeout(() => {
                        statusSelect.focus();
                    }, 100);
                });
            }

            // Helper function to get status badge class
            function getStatusBadgeClass(status) {
                const classes = {
                    'Pending': 'bg-secondary',
                    'Sample Collected': 'bg-info',
                    'In Progress': 'bg-primary',
                    'Completed': 'bg-success',
                    'Cancelled': 'bg-danger',
                    'On Hold': 'bg-warning',
                    'Selected': 'bg-warning'
                };
                return classes[status] || 'bg-secondary';
            }

            // Update preview when status changes
            statusSelect.addEventListener('change', function() {
                const selectedStatus = this.value;
                const badgeClass = getStatusBadgeClass(selectedStatus);

                // Update any preview elements
                const previewElements = document.querySelectorAll('.status-preview');
                previewElements.forEach(el => {
                    el.className = `badge ${badgeClass} status-preview`;
                    el.innerHTML = `<i class="fas ${getStatusIcon(selectedStatus)} me-1"></i>${selectedStatus}`;
                });
            });

            // Helper function to get status icon
            function getStatusIcon(status) {
                const icons = {
                    'Pending': 'fa-clock',
                    'Sample Collected': 'fa-vial',
                    'In Progress': 'fa-microscope',
                    'Completed': 'fa-check',
                    'Cancelled': 'fa-times',
                    'On Hold': 'fa-pause',
                    'Selected': 'fa-check-circle'
                };
                return icons[status] || 'fa-question-circle';
            }
        });
    </script>
}